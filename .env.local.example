# ---------------------------------------------------------------------------
# Database (Neon / Vercel Postgres)
# ---------------------------------------------------------------------------
# Keep the real value only in .env.local or Vercel Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE_NAME?sslmode=require
PRODUCTS_TABLE=products

# Neon requires SSL.
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# File Storage (Vercel Blob)
# Stores product images, quote PDFs, contracts, and floor plans.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ---------------------------------------------------------------------------
# Authentication (JWT session)
# ---------------------------------------------------------------------------
# Required — used to sign/verify JWT session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Development mode: verification codes are returned in the API response
# so you can log in without a real SMS/email provider.
# Set to "false" or remove in production.
AUTH_DEV_MODE=true

# The first user to sign up is automatically promoted to admin.
# Set to the email/phone of the intended first admin, or remove to disable.
# AUTH_INITIAL_ADMIN=admin@example.com
