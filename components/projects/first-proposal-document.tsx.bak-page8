export type FirstProposalTheme = keyof typeof FIRST_PROPOSAL_THEMES

export type FirstProposalDocumentProps = {
  snapshot: ProjectDeliverySnapshot
  floors: PointMapPrintFloor[]
  brand: DocumentBrand
  theme: FirstProposalTheme
  documentRef?: React.Ref<HTMLElement>
  demo?: boolean
}

type Room = { name: string; points: PointMapNode[]; items: ProjectDeliveryQuoteItem[]; amount: number }
type RoomPageChunk = { rooms: Room[]; scenes: PointMapScene[]; index: number }

const QUOTE_SCOPE_NOTE = "报价含基础安装调试，不含强电改造和额外布线费用。最终金额以现场复核和客户确认版本为准。"
const SCENE_CONFIRM_NOTE = "“待确认”表示仍需沟通；“设计已确认”不代表设备已经安装或功能已经验收。"

function versionLabel(snapshot: ProjectDeliverySnapshot) {
  return snapshot.version > 0 ? `固定交付 V${snapshot.version}` : "已保存资料预览 · 非固定版本"
}

function pointName(point: PointMapNode) {
  const state = point.usage === "reserve" ? "（预留）" : point.usage === "proposed" ? "（待评估）" : ""
  return `${point.room || "房间待定"} ${point.code || point.name}${state}`
}

function date(value: string) {
  const parsed = new Date(value)
  return Number.isNaN(parsed.getTime()) ? value || "日期待补充" : parsed.toLocaleDateString("zh-CN", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit" })
}

export const FIRST_PROPOSAL_MAX_PAGES = 10
export type FirstProposalDensity = "standard" | "compact"

export type FirstProposalLayout = {
  density: FirstProposalDensity
  rooms: Room[][]
  roomPages: RoomPageChunk[]
  scenes: PointMapScene[][]
  products: never[]
  quotes: ProjectDeliveryQuoteItem[][]
  floors: PointMapPrintFloor[][]
  pageCount: number
  overBudget: boolean
}

/** Space estimates never change, merge or drop a saved quotation line. */
function pages<T>(items: T[], capacity: number, weight: (item: T) => number = () => 1, continuationCapacity = capacity): T[][] {
  const result: T[][] = []
  let current: T[] = [], used = 0
  for (const item of items) {
    const size = weight(item)
    if (current.length && used + size > (result.length ? continuationCapacity : capacity)) {
      result.push(current); current = []; used = 0
    }
    current.push(item); used += size
  }
  if (current.length) result.push(current)
  return result
}

// Approximate rendered lines, respecting explicit newlines and wide CJK glyphs.
function textLines(text: string, width: number) {
  return text.split(/\r?\n/).reduce((sum, line) => sum + Math.max(1, Math.ceil(Array.from(line).reduce((n, char) => n + (/[^\x00-\xff]/.test(char) ? 1 : 0.58), 0) / width)), 0)
}

function projectRooms(snapshot: ProjectDeliverySnapshot): Room[] {
  const rooms = new Map<string, Room>()
  const floors = new Map((snapshot.plan.floors ?? []).map((floor) => [floor.id, floor.name]))
  const quotedRoomNames = [...new Set((snapshot.quote?.items ?? []).map((item) => item.room.trim()))]
  const canonical = (value: string) => value.replace(/\s*\/\s*/g, "/").trim()
  const pointRoomFloors = new Map<string, Set<string>>()
  for (const point of snapshot.plan.points) {
    const room = point.room.trim()
    if (!pointRoomFloors.has(room)) pointRoomFloors.set(room, new Set())
    pointRoomFloors.get(room)!.add(point.floorId ?? "")
  }
  const get = (name: string) => {
    const roomName = name.trim() || "全屋 / 未分房间"
    if (!rooms.has(roomName)) rooms.set(roomName, { name: roomName, points: [], items: [], amount: 0 })
    return rooms.get(roomName)!
  }
  for (const point of snapshot.plan.points) {
    const floorName = floors.get(point.floorId ?? "")
    const composite = floorName ? `${floorName} / ${point.room.trim()}` : point.room
    const quotedComposite = quotedRoomNames.find((room) => canonical(room) === canonical(composite))
    const multipleFloors = (pointRoomFloors.get(point.room.trim())?.size ?? 0) > 1
    get(quotedComposite || (multipleFloors && floorName ? composite : point.room)).points.push(point)
  }
  for (const item of snapshot.quote?.items ?? []) {
    const room = get(item.room)
    room.items.push(item)
    room.amount += deliveryLineTotal(item)
  }
  return [...rooms.values()]
}

function scenesForRooms(rooms: Room[], snapshot: ProjectDeliverySnapshot, claimed: Set<string>): PointMapScene[] {
  const pointIds = new Set(rooms.flatMap((room) => room.points.map((point) => point.id)))
  const matched: PointMapScene[] = []
  for (const scene of snapshot.plan.scenes ?? []) {
    if (claimed.has(scene.id)) continue
    const linked = scene.pointIds.some((id) => pointIds.has(id))
    const nameHit = !scene.pointIds.length && rooms.some((room) => scene.name.includes(room.name.split("/").pop()?.trim() || room.name))
    if (linked || nameHit) {
      claimed.add(scene.id)
      matched.push(scene)
    }
  }
  return matched
}

function sceneWeight(scene: PointMapScene, compact: boolean) {
  return Math.max(compact ? 1.1 : 1.4, (textLines(scene.name, 18) + textLines(scene.trigger, 24) + textLines(scene.description, 24) + 1.2) * (compact ? 0.35 : 0.45))
}

function roomWeight(room: Room, scenes: PointMapScene[], compact: boolean) {
  // Weight tracks real A4 cost: mood/headers once per page share, thumbs+rows, point list, linked scenes.
  // Under-weighting packs too many rooms onto one sheet and trips assertFirstProposalPrintLayout.
  const itemWeight = room.items.reduce((sum, item) => sum + textLines(item.name, compact ? 32 : 28) * (compact ? 0.38 : 0.5) + (compact ? 0.45 : 0.55), 0)
  const pointWeight = room.points.length * (compact ? 0.25 : 0.35)
  const linked = scenes.reduce((sum, scene) => sum + sceneWeight(scene, compact), 0)
  const base = room.items.length || room.points.length ? (compact ? 1.8 : 2.4) : (compact ? 0.8 : 1.1)
  return Math.max(compact ? 1.2 : 1.8, base + pointWeight + itemWeight + linked)
}

function buildRoomPages(snapshot: ProjectDeliverySnapshot, rooms: Room[], compact: boolean): RoomPageChunk[] {
  // Compact denser than standard; keep headroom under A4 after mood+excerpts, and leave pages for floor overflow.
  const capacity = compact ? 16 : 12
  const claimed = new Set<string>()
  const result: RoomPageChunk[] = []
  let pageIndex = 0

  const pushPage = (pageRooms: Room[], pageScenes: PointMapScene[]) => {
    result.push({ rooms: pageRooms, scenes: pageScenes, index: pageIndex++ })
  }

  const flushScenes = (pageRooms: Room[], scenes: PointMapScene[], baseWeight: number) => {
    if (!scenes.length) {
      pushPage(pageRooms, [])
      return
    }
    let batch: PointMapScene[] = []
    let used = baseWeight
    let first = true
    for (const scene of scenes) {
      const weight = sceneWeight(scene, compact)
      if (batch.length && used + weight > capacity) {
        pushPage(first ? pageRooms : [], batch)
        batch = []
        used = first ? 1.2 : 1.2
        first = false
      }
      batch.push(scene)
      used += weight
    }
    if (batch.length || first) pushPage(first ? pageRooms : [], batch)
  }

  let currentRooms: Room[] = []
  let currentScenes: PointMapScene[] = []
  let used = 0

  const flushCurrent = () => {
    if (!currentRooms.length && !currentScenes.length) return
    const base = Math.max(1.2, used - currentScenes.reduce((sum, scene) => sum + sceneWeight(scene, compact), 0))
    flushScenes(currentRooms, currentScenes, base)
    currentRooms = []
    currentScenes = []
    used = 0
  }

  for (const room of rooms) {
    const scenes = scenesForRooms([room], snapshot, claimed)
    const base = roomWeight(room, [], compact)
    const total = roomWeight(room, scenes, compact)
    // A single heavy room (many scenes / long copy) gets its own split pages.
    if (total > capacity) {
      flushCurrent()
      flushScenes([room], scenes, base)
      continue
    }
    if (currentRooms.length && used + total > capacity) flushCurrent()
    currentRooms.push(room)
    currentScenes.push(...scenes)
    used += total
  }
  flushCurrent()

  const orphans = (snapshot.plan.scenes ?? []).filter((scene) => !claimed.has(scene.id))
  if (orphans.length) flushScenes([], orphans, 1.2)
  return result
}

function layoutAtDensity(snapshot: ProjectDeliverySnapshot, floors: PointMapPrintFloor[], density: FirstProposalDensity): FirstProposalLayout {
  const compact = density === "compact"
  const allRooms = projectRooms(snapshot)
  const roomIndexChunks = pages(allRooms, compact ? 18 : 14, (room) => Math.max(1, textLines(room.name, 28)), 28)
  const roomPages = buildRoomPages(snapshot, allRooms, compact)
  const quotes = pages(snapshot.quote?.items ?? [], compact ? 290 : 176, (item) => {
    const width = compact ? 40 : 34
    const lineHeight = compact ? 2.85 : 3.9
    const productLines = textLines(item.name, width) + textLines([item.brand, item.sku].filter(Boolean).join(" · "), width - 4) + (item.spec ? textLines(item.spec, width) : 0) + textLines(quoteVerificationLabel(item), width) + (verificationReasons(item) ? textLines(verificationReasons(item), width + 2) : 0)
    return Math.max(productLines * lineHeight, textLines(item.room || "全屋", 7) * lineHeight, textLines(money(deliveryLineTotal(item)), 7) * lineHeight) + (compact ? 2.2 : 4)
  })
  // Prefer floors on the overview; overflow only when there are many sheets.
  const overviewFloorCapacity = compact ? 2 : 2
  const floorPages = floors.length
    ? (floors.length > overviewFloorCapacity ? pages(floors, overviewFloorCapacity) : [floors])
    : []
  const overviewCount = Math.max(1, roomIndexChunks.length)
  const floorOverflow = Math.max(0, floorPages.length - 1)
  const narrativePages = Math.max(1, roomPages.length)
  const quotePages = Math.max(1, quotes.length)
  const pageCount = 1 + overviewCount + floorOverflow + narrativePages + quotePages
  return {
    density,
    rooms: roomIndexChunks.length ? roomIndexChunks : [[]],
    roomPages,
    scenes: roomPages.map((chunk) => chunk.scenes),
    products: [],
    quotes: quotes.length ? quotes : [[]],
    floors: floorPages,
    pageCount,
    overBudget: pageCount > FIRST_PROPOSAL_MAX_PAGES,
  }
}

/** Try a tighter complete layout before refusing an oversized document at print time. */
export function createFirstProposalLayout(snapshot: ProjectDeliverySnapshot, floors: PointMapPrintFloor[]): FirstProposalLayout {
  const standard = layoutAtDensity(snapshot, floors, "standard")
  return standard.overBudget ? layoutAtDensity(snapshot, floors, "compact") : standard
}

function verificationReasons(item: ProjectDeliveryQuoteItem) {
  return quoteVerification(item).reasons.join("；")
}

/**
 * Inline brand marks sit inside 9px text runs in the product list and the quote
 * table, so their box is pinned here rather than by the shared `.fp-brand-logo`
 * rule (10mm square, used by the document brand on the cover and the closing).
 * `display: inline-block` also overrides the document-wide `img { display: block }`
 * so the mark stays on the same line as the brand text, and `maxWidth` keeps an
 * unusually wide wordmark from pushing the text onto its own line.
 */
const BRAND_MARK_STYLE: React.CSSProperties = {
  height: 12, width: "auto", maxWidth: "24mm", objectFit: "contain",
  verticalAlign: "middle", marginRight: 5, display: "inline-block",
}

/**
 * Referential brand mark for one saved quote line. Renders only when the saved
 * `brand` field resolves to a real brand with a verified logo file: ecosystems
 * (Apple Home, Xiaomi Home) and protocols (Matter) stay text-only, and so do
 * unknown brands and brands without a cleared logo (e.g. Apple). The brand text
 * is always kept beside the mark, so the document still reads without images.
 */
function BrandMark({ value }: { value?: string | null }) {
  const asset = resolveProposalBrand(value)
  if (!asset || asset.kind !== "brand" || !asset.logoSrc) return null
  return <img src={asset.logoSrc} alt="" className="fp-brand-logo fp-brand-logo-inline" style={BRAND_MARK_STYLE} />
}

function Brand({ brand, closing = false }: { brand: DocumentBrand; closing?: boolean }) {
  return <div className={`fp-brand${closing ? " fp-brand-closing" : ""}`}>
    {brand.logoSrc ? <img src={brand.logoSrc} alt="" className="fp-brand-logo" /> : null}
    <div><strong>{brand.companyName}</strong>{closing && brand.contact ? <p>{brand.contact}</p> : null}{closing && brand.address ? <p>{brand.address}</p> : null}</div>
  </div>
}

function Footer({ snapshot, brand, demo, label }: { snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean; label: string }) {
  return <footer className="fp-footer"><span>{demo ? "示例演示 · 非客户正式报价" : brand.companyName}</span><span>{label} · {snapshot.version > 0 ? `V${snapshot.version}` : "版本待生成"}</span></footer>
}

function Page({ children, snapshot, brand, demo, label, className = "" }: {
  children: React.ReactNode; snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean; label: string; className?: string
}) {
  return <section className={`fp-page ${className}`} aria-label={label}>
    <div className="fp-running"><span>{brand.companyName}</span><span>{snapshot.project.name}</span></div>
    <div className="fp-page-body">{children}</div>
    <Footer snapshot={snapshot} brand={brand} demo={demo} label={label} />
  </section>
}

function Heading({ title, description, aside }: { title: string; description?: string; aside?: string }) {
  return <header className="fp-heading"><div><h2>{title}</h2>{description ? <p>{description}</p> : null}</div>{aside ? <span>{aside}</span> : null}</header>
}

function Cover({ snapshot, brand, theme, demo }: Omit<FirstProposalDocumentProps, "floors" | "documentRef">) {
  const meta = FIRST_PROPOSAL_THEMES[theme]
  const sidebar = theme === "atelier" || theme === "gallery"
  return <section className={`fp-page fp-cover fp-cover-${theme}`} aria-label="提案封面">
    <div className="fp-cover-brand"><Brand brand={brand} /><span>{demo ? "示例演示" : "首次提案"}</span></div>
    <div className="fp-cover-title"><h1>{meta.coverLines[0]}<br />{meta.coverLines[1]}</h1><p>全屋智能 · 点位设计与服务报价</p></div>
    <div className="fp-cover-composition">
      {sidebar ? <div className="fp-cover-sidebar"><span>{theme === "gallery" ? <>材质有序<br />光影从容</> : <>空间有序<br />生活从容</>}</span><p>{theme === "gallery" ? <>让技术退后，<br />让空间先被感受。</> : <>从一次回家，<br />到每个安心的夜晚。</>}</p><div><strong>{snapshot.project.name}</strong><p>{snapshot.project.customer || "客户信息待补充"}</p></div></div> : null}
      <figure className="fp-cover-image"><img src={meta.heroSrc} alt={meta.heroAlt} /><figcaption>AI 意向示意 · 非项目实景</figcaption></figure>
    </div>
    <div className="fp-cover-project"><div><h2>{snapshot.project.name}</h2><p>{snapshot.project.address || "项目地址待补充"}</p></div><div>{snapshot.project.code ? <span>项目编号 {snapshot.project.code}</span> : null}<span>{snapshot.version > 0 ? `固定交付版本 V${snapshot.version}` : "待生成固定交付版本"}</span><span>{date(snapshot.createdAt)}</span></div></div>
    {!sidebar ? <p className="fp-cover-customer">为 {snapshot.project.customer || "您"} 呈上 · 生活场景 / 点位设计 / 透明报价 / 安心交付</p> : null}
    <Footer snapshot={snapshot} brand={brand} demo={Boolean(demo)} label={meta.name} />
  </section>
}

function needPhrases(snapshot: ProjectDeliverySnapshot) {
  const scenes = snapshot.plan.scenes ?? []
  const rooms = projectRooms(snapshot)
  const phrases = [
    { label: "生活需要", text: scenes[0]?.name ? `围绕「${scenes[0].name}」展开日常回应` : "先从回家与日常动线开始" },
    { label: "休息需要", text: rooms.find((room) => /卧|睡/.test(room.name)) ? "卧室灯光与就寝节奏可一键收束" : "休息空间的灯光与氛围待沟通" },
    { label: "安心需要", text: rooms.find((room) => /厨|卫|玄关|门/.test(room.name)) ? "厨房、门窗与关键节点及时感知" : "安防与感知范围待现场确认" },
    { label: "配置原则", text: "够用、可维护、边界清楚" },
  ]
  return phrases
}

function Overview({ snapshot, theme, chunks, floors, ...common }: {
  snapshot: ProjectDeliverySnapshot; theme: FirstProposalTheme; chunks: Room[][]; floors: PointMapPrintFloor[][]; brand: DocumentBrand; demo: boolean
}) {
  const quote = snapshot.quote
  const rooms = chunks.flat()
  const meta = FIRST_PROPOSAL_THEMES[theme]
  const scenes = snapshot.plan.scenes ?? []
  const overviewFloors = floors[0] ?? []
  return <>
    {chunks.map((chunk, index) => <Page key={`overview-${index}`} snapshot={snapshot} {...common} label={`总览 · 项目需求与点位${index ? ` · 续 ${index}` : ""}`} className="fp-overview-page">
      <Heading
        title={index ? "空间索引，继续核对。" : meta.overviewTitle}
        description={index ? "延续本版本的空间索引；金额只汇总已保存报价。" : "需求、全屋点位与空间索引同页；场景与设备明细见房间页。"}
        aside={index ? versionLabel(snapshot) : meta.overviewAside}
      />
      {!index ? <div className="fp-overview-top">
        <div className="fp-needs">{needPhrases(snapshot).map((need) => <div key={need.label}><span>{need.label}</span><strong>{need.text}</strong></div>)}</div>
        <div className="fp-overview-meta">
          <div className="fp-facts">
            <div><span>为您呈上</span><strong>{snapshot.project.customer || "客户待补充"}</strong></div>
            <div><span>空间范围</span><strong>{rooms.length} 个配置区域</strong></div>
            <div><span>设计点位</span><strong>{snapshot.plan.points.length} 处</strong></div>
            <div><span>生活场景</span><strong>{scenes.length} 项</strong></div>
          </div>
          {quote ? <div className="fp-budget-total"><div><span>本版应收总额</span><strong>{money(quote.total)}</strong><p>{quote.quoteNo} · {quote.title}</p></div><p>{quote.items.length} 行真实报价 · {quote.items.filter((item) => quoteVerification(item).status === "unverified").length} 行未核验</p></div> : <p className="fp-empty fp-empty-inline">本版尚未保存报价，暂不展示金额。选配与价格明确后，再形成可确认的预算。</p>}
        </div>
        {!scenes.length ? <p className="fp-empty fp-empty-inline">本版本尚未保存场景，暂不将生活设想写成已包含功能。确认触发方式、动作与关联设备后，再补入下一版提案。</p> : null}
      </div> : null}
      <div className={`fp-overview-shell${overviewFloors.length && !index ? "" : " fp-overview-shell-index-only"}`}>
        {!index && overviewFloors.length ? <div className="fp-overview-floors" data-floor-count={overviewFloors.length}>
          <h3>住宅平面 · 全屋 {snapshot.plan.points.length} 点</h3>
          <div className="fp-floor-grid" data-floor-count={overviewFloors.length}>{overviewFloors.map((floor) => {
            const pins = snapshot.plan.points.filter((point) => point.floorId === floor.id && point.placed)
            return <figure className="fp-floor-figure" key={floor.id} data-floor-id={floor.id}>
              <figcaption><strong>{floor.name}</strong><span>示意，非施工图</span></figcaption>
              <div className="fp-floor-image fp-floor-image-mapped">
                <img src={floor.src} alt={`${floor.name}完整点位设计图`} />
                {pins.map((point, pinIndex) => <span key={point.id} className="fp-point-pin" style={{ left: `${Math.min(96, Math.max(4, point.x))}%`, top: `${Math.min(96, Math.max(4, point.y))}%` }} title={point.code || point.name}>{String(pinIndex + 1).padStart(2, "0")}</span>)}
              </div>
            </figure>
          })}</div>
        </div> : null}
        <div className="fp-room-index"><h3>空间索引{quote ? " · 产品折后预算" : ""} · 点位对照</h3>
          <table className="fp-budget-table"><thead><tr><th>空间</th><th>点位</th><th>行数</th>{quote ? <th>折后小计</th> : null}</tr></thead>
            <tbody>{chunk.map((room) => <tr key={room.name}><td><strong>{room.name}</strong>{room.points.some((point) => point.usage === "reserve" || point.usage === "proposed") ? <span>（含预留 / 待评估）</span> : null}{room.points.length ? <span className="fp-point-codes">{room.points.map((point) => point.code || point.name).filter(Boolean).join(" · ")}</span> : null}</td><td>{room.points.length}</td><td>{room.items.length}</td>{quote ? <td>{money(room.amount)}</td> : null}</tr>)}</tbody>
          </table>
          {!chunk.length ? <p className="fp-empty fp-empty-inline">本版尚未保存房间配置，范围需沟通后补充。</p> : null}
        </div>
      </div>
      {!index ? <p className="fp-scope-note">分空间小计仅含对应产品折后金额，安装调试单列；应收以本版已保存总额为准。场景与设备明细见后续房间页。{QUOTE_SCOPE_NOTE}</p> : null}
    </Page>)}
    {floors.slice(1).map((chunk, index) => <Page key={`floor-overflow-${index}`} snapshot={snapshot} {...common} label={`点位设计图 · 续 ${index + 1}`} className="fp-floor-page">
      <Heading title="让每一处回应，都有位置。" description="本版本楼层图完整呈现，不裁切原图；安装位置、回路与现场条件需另行核对。" aside={`${versionLabel(snapshot)} · 图组 ${index + 2}/${floors.length}`} />
      <div className="fp-floor-grid" data-floor-count={chunk.length}>{chunk.map((floor) => <figure className="fp-floor-figure" key={floor.id} data-floor-id={floor.id}><figcaption><strong>{floor.name}</strong><span>完整点位设计图</span></figcaption><div className="fp-floor-image"><img src={floor.src} alt={`${floor.name}完整点位设计图`} /></div></figure>)}</div>
      <p className="fp-scope-note">{snapshot.version > 0 ? "本图复用同一固定版本的楼层图。" : "本图为已保存资料预览，尚未形成固定交付版本。"}预留、待评估与未定位设备不等同于已报价范围。</p>
    </Page>)}
  </>
}

function roomMood(theme: FirstProposalTheme, rooms: Room[]) {
  const meta = FIRST_PROPOSAL_THEMES[theme]
  const joined = rooms.map((room) => room.name).join(" ")
  if (/卧|睡|儿童|小孩|男孩|女孩|儿子|女儿|老人/.test(joined)) return { src: meta.sceneSrc, alt: `${meta.name}休息空间意向` }
  return { src: meta.heroSrc, alt: `${meta.name}空间意向` }
}

function roomTitle(rooms: Room[], pageIndex: number) {
  if (!rooms.length) return { title: "先把生活场景说清楚。", english: "SCENES" }
  const names = rooms.map((room) => room.name.replace(/^.*\/\s*/, ""))
  const label = names.slice(0, 2).join("与")
  const titles = [
    { match: /玄关|门厅|入户/, title: "进门的那一刻，生活开始切换。", english: "ARRIVE & LEAVE" },
    { match: /客厅|起居|餐厅/, title: "把日常起居，调到舒适。", english: "LIVE & GATHER" },
    { match: /卧|睡/, title: "把一天的忙碌，留在灯后。", english: "REST & RESET" },
    { match: /厨|餐/, title: "厨房与餐区，感知与便利同在。", english: "COOK & CARE" },
  ]
  for (const candidate of titles) {
    if (rooms.some((room) => candidate.match.test(room.name))) return { title: candidate.title, english: candidate.english }
  }
  return { title: `${label}：点位、场景与投入。`, english: `ZONE ${String(pageIndex + 1).padStart(2, "0")}` }
}

function SceneStory({ scene, snapshot, index }: { scene: PointMapScene; snapshot: ProjectDeliverySnapshot; index: number }) {
  const related = scene.pointIds.map((id) => snapshot.plan.points.find((point) => point.id === id))
  const rooms = [...new Set(related.filter((point): point is PointMapNode => Boolean(point)).map((point) => point.room || "房间待定"))]
  return <article className="fp-scene">
    <div className="fp-scene-title"><span className="fp-scene-index">{String(index + 1).padStart(2, "0")}</span><h3>{scene.name || "未命名场景"}</h3><span className={`fp-status ${scene.status === "confirmed" ? "fp-status-confirmed" : ""}`}>{scene.status === "confirmed" ? "设计已确认" : "待确认"}</span></div>
    <div className="fp-scene-story"><div><span>当您这样做</span><p>{scene.trigger || "触发方式待沟通"}</p></div><div><span>家会这样回应</span><p>{scene.description || "具体动作待沟通"}</p></div></div>
    <p className="fp-scene-links">{rooms.length ? `涉及空间：${rooms.join("、")}。` : "涉及空间待核对。"}{scene.pointIds.length ? `关联 ${scene.pointIds.length} 处点位：${related.map((point) => point ? pointName(point) : "点位待核对").join("、")}` : "本场景尚未关联设备点位。"}</p>
  </article>
}

function RoomPages({ snapshot, theme, chunks, floors: _floors, ...common }: {
  snapshot: ProjectDeliverySnapshot; theme: FirstProposalTheme; chunks: RoomPageChunk[]; floors: PointMapPrintFloor[]; brand: DocumentBrand; demo: boolean
}) {
  const pagesToRender = chunks.length ? chunks : [{ rooms: [] as Room[], scenes: [] as PointMapScene[], index: 0 }]
  let sceneIndex = 0
  return pagesToRender.map((chunk) => {
    const mood = roomMood(theme, chunk.rooms)
    const heading = roomTitle(chunk.rooms, chunk.index)
    const label = chunk.rooms.length ? `房间叙事 · ${chunk.rooms.map((room) => room.name).join(" / ")}` : "生活场景"
    return <Page key={`room-${chunk.index}`} snapshot={snapshot} {...common} label={label} className="fp-room-page">
      <Heading title={heading.title} description={chunk.rooms.length ? `${chunk.rooms.map((room) => room.name).join("、")} · 点位 / 场景 / 本区报价` : "本页汇总尚未归属具体房间的已保存场景。"} aside={heading.english} />
      <div className="fp-room-layout">
        <div className="fp-room-main">
          <figure className="fp-room-mood">
            <img src={mood.src} alt={mood.alt} />
            <figcaption>AI 意向示意 · 非项目实景</figcaption>
            {chunk.rooms.flatMap((room) => room.points).slice(0, 8).map((point, index) => (
              <span key={point.id} className="fp-mood-pin" data-pin-index={index}>{String(index + 1).padStart(2, "0")} {point.code || point.name}</span>
            ))}
          </figure>
          <div className="fp-room-points">
            <h3>点位对照</h3>
            {chunk.rooms.some((room) => room.points.length) ? <ol>{chunk.rooms.flatMap((room) => room.points).map((point, index) => {
              const room = chunk.rooms.find((entry) => entry.points.some((candidate) => candidate.id === point.id))
              return <li key={point.id}><strong>{String(index + 1).padStart(2, "0")}</strong><span>{room?.name || "房间待定"} · {point.code || point.name}</span><em>{point.name}</em></li>
            })}</ol> : <p className="fp-empty">本区尚未保存点位。</p>}
          </div>
          <div className="fp-room-quote">
            <h3>本区设备与报价行</h3>
            {chunk.rooms.some((room) => room.items.length) ? chunk.rooms.map((room) => room.items.length ? <div key={room.name} className="fp-room-quote-block">
              <div className="fp-room-quote-head"><strong>{room.name}</strong><span>{room.items.length} 行 · 小计 {money(room.amount)}</span></div>
              <table className="fp-room-quote-table"><tbody>{room.items.map((item) => {
                const product = snapshot.products.find((entry) => entry.id === item.id)
                const src = product?.image || item.image
                return <tr key={item.lineId} data-room-quote-line-id={item.lineId}><td>{src ? <img src={src} alt="" className="fp-room-item-thumb" /> : null}<div><strong>{item.name}</strong><span><BrandMark value={item.brand} />{[item.brand, item.sku].filter(Boolean).join(" · ") || "品牌 / 型号待补充"}</span></div></td><td>{item.quantity} {item.unit || "个"}</td><td>{money(deliveryLineTotal(item))}</td></tr>
              })}</tbody></table>
            </div> : null) : <p className="fp-empty">本区暂无已保存报价行；完整金额见后页报价。</p>}
          </div>
        </div>
        <aside className="fp-room-side">
          <h3>关联场景</h3>
          <div className="fp-scene-list fp-scene-list-stack">{chunk.scenes.length ? chunk.scenes.map((scene) => <SceneStory key={scene.id} scene={scene} snapshot={snapshot} index={sceneIndex++} />) : <div className="fp-empty"><h3>本区暂无已保存场景</h3><p>确认触发方式、动作与关联设备后，再写入下一版。</p></div>}</div>
          <p className="fp-callout">传感器只能感知状态变化，不能识别具体是谁。重要场景建议保留手动确认。</p>
          <p className="fp-scope-note">{SCENE_CONFIRM_NOTE}</p>
        </aside>
      </div>
    </Page>
  })
}

function QuoteDetails({ snapshot, chunks, ...common }: { snapshot: ProjectDeliverySnapshot; chunks: ProjectDeliveryQuoteItem[][]; brand: DocumentBrand; demo: boolean }) {
  const quote = snapshot.quote
  const rooms = projectRooms(snapshot)
  return chunks.map((chunk, index) => {
    const last = index === chunks.length - 1 || !chunks.length
    return <Page key={index} snapshot={snapshot} {...common} label={`完整报价${index ? ` · 续 ${index}` : ""}`} className="fp-quote-page">
      <Heading title="每一笔投入，都有清楚的去向。" description="产品、规格、范围与金额共同构成本次报价。未核验原因与配套遗漏不因排版而省略。" aside={quote?.quoteNo || "CLEAR INVESTMENT"} />
      {quote ? <>
        <div className="fp-quote-context"><span>{quote.title || "项目方案报价"}</span><span>{versionLabel(snapshot)} · {quote.items.length} 行报价</span></div>
        <div className="fp-quote-layout">
          <table className="fp-quote-table"><colgroup><col className="fp-col-product" /><col className="fp-col-room" /><col className="fp-col-quantity" /><col className="fp-col-money" /><col className="fp-col-money" /><col className="fp-col-money" /></colgroup><thead><tr><th>产品 / 规格与说明</th><th>房间</th><th>数量</th><th>原单价</th><th>折后单价</th><th>折后小计</th></tr></thead><tbody>{chunk.map((item) => <tr key={item.lineId} data-quote-line-id={item.lineId}><td><strong>{item.name}</strong><span><BrandMark value={item.brand} />{[item.brand, item.sku].filter(Boolean).join(" · ")}</span>{item.spec ? <span>{item.spec}</span> : null}<span className="fp-verification">{quoteVerificationLabel(item)}</span>{verificationReasons(item) ? <span className="fp-verification-reason">{verificationReasons(item)}</span> : null}</td><td>{item.room || "全屋"}</td><td>{item.quantity}<br />{item.unit || "个"}</td><td>{money(item.price)}</td><td>{money(deliveryLineUnitPrice(item))}</td><td><strong>{money(deliveryLineTotal(item))}</strong></td></tr>)}</tbody></table>
          {last ? <aside className="fp-quote-aside">
            <div className="fp-quote-summary-stack">
              <div><span>产品原价</span><strong>{money(quote.subtotal)}</strong></div>
              <div><span>优惠金额</span><strong>{money(quote.discount)}</strong></div>
              <div><span>安装调试</span><strong>{money(quote.installationFee)}</strong></div>
              <div className="fp-quote-total"><span>本版应收总额</span><strong>{money(quote.total)}</strong></div>
            </div>
            {rooms.some((room) => room.items.length) ? <div className="fp-quote-by-room"><h3>按空间核对 · 仅设备</h3><ul>{rooms.filter((room) => room.items.length).map((room) => <li key={room.name}><span>{room.name}</span><strong>{money(room.amount)}</strong></li>)}</ul></div> : null}
          </aside> : null}
        </div>
        {!last ? <p className="fp-quote-continued">报价明细续下页；完整合计见本组末页。</p> : null}
        <p className="fp-scope-note">{QUOTE_SCOPE_NOTE}</p>
        <p className="fp-scope-note">未核验报价用于方案沟通，不等同于正式采购确认。型号、配套用料、实测数量与安装条件应在后续逐项核对。房间页小计为摘录，完整行项目与核验原因以本表为准。</p>
        {last ? <Confirmation snapshot={snapshot} {...common} /> : null}
      </> : <><p className="fp-empty">本版尚未保存报价，暂无可列示的产品金额。</p><Confirmation snapshot={snapshot} {...common} /></>}
    </Page>
  })
}

function Confirmation({ snapshot, brand }: { snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean }) {
  const unplaced = snapshot.plan.points.filter((point) => !point.placed)
  const unverified = snapshot.quote?.items.filter((item) => quoteVerification(item).status === "unverified") ?? []
  const proposed = snapshot.plan.scenes?.filter((scene) => scene.status !== "confirmed") ?? []
  const quotedPointIds = new Set((snapshot.quote?.items ?? []).flatMap((item) => item.pointIds ?? []))
  const pointsToCheck = snapshot.plan.points.filter((point) => !quotedPointIds.has(point.id) && point.usage !== "reserve" && point.usage !== "proposed")
  return <div className="fp-confirmation">
    <div className="fp-confirm-grid"><div><h3>本版待沟通事项</h3><ul><li>{proposed.length} 项场景待确认 · {unplaced.length} 处设备待定位 · {unverified.length} 行产品未核验。</li><li>设计点位不等于已报价范围，预留 / 待评估点位不直接形成采购数量。{pointsToCheck.length ? `另有 ${pointsToCheck.length} 处点位尚未与报价行明确关联，需核对是否由手动报价覆盖。` : ""}</li><li>型号、配套用料、现场条件需复核；工期、付款、质保及售后范围待双方另行约定。</li></ul></div><div><h3>您的想法</h3><p>想保留的体验 / 需要调整的地方</p><div className="fp-note-lines" aria-hidden="true"><span /><span /></div><div className="fp-confirmation-sign"><span>沟通确认</span><i /><span>日期</span><i /></div></div></div>
    <div className="fp-closing"><div><Brand brand={brand} closing /><p className="fp-confirmation-note">记录本次沟通意见；范围、价格及双方权利义务以另行确认的文件为准。</p></div>{brand.qrSrc ? <figure><img src={brand.qrSrc} alt="联系二维码" /><figcaption>扫码联系</figcaption></figure> : null}</div>
  </div>
}

/** All content comes from one immutable delivery; the component never fetches or reprices products. */
export function FirstProposalDocument({ snapshot, floors, brand, theme, documentRef, demo = false }: FirstProposalDocumentProps) {
  const layout = createFirstProposalLayout(snapshot, floors)
  const common = { snapshot, brand, demo }
  return <article ref={documentRef} className={`first-proposal-document fp-theme-${theme}`} data-proposal-theme={theme} data-proposal-density={layout.density} data-proposal-page-count={layout.pageCount} data-proposal-over-budget={layout.overBudget}>
    <Cover {...common} theme={theme} />
    <Overview {...common} theme={theme} chunks={layout.rooms} floors={layout.floors} />
    <RoomPages {...common} theme={theme} chunks={layout.roomPages} floors={floors} />
    <QuoteDetails {...common} chunks={layout.quotes} />
  </article>
}
