    heroSrc: "/assets/proposals/gallery-living.jpg", sceneSrc: "/assets/proposals/future-living.jpg", heroAlt: "光影艺廊住宅意向",
    coverLines: ["让空间，", "回应生活。"], sceneTitle: "把控制藏进空间秩序。", sceneQuote: ["当技术退到幕后，", "设计才真正开始。", "每一次回应都恰到好处。"],
  },
} as const

export type FirstProposalTheme = keyof typeof FIRST_PROPOSAL_THEMES

export type FirstProposalDocumentProps = {
  snapshot: ProjectDeliverySnapshot
  floors: PointMapPrintFloor[]
  brand: DocumentBrand
  theme: FirstProposalTheme
  documentRef?: React.Ref<HTMLElement>
  demo?: boolean
}

type Room = { name: string; points: PointMapNode[]; items: ProjectDeliveryQuoteItem[]; amount: number }
const QUOTE_SCOPE_NOTE = "报价含基础安装调试，不含强电改造和额外布线费用。最终金额以现场复核和客户确认版本为准。"

function versionLabel(snapshot: ProjectDeliverySnapshot) {
  return snapshot.version > 0 ? `固定交付 V${snapshot.version}` : "已保存资料预览 · 非固定版本"
}

function pointName(point: PointMapNode) {
  const state = point.usage === "reserve" ? "（预留）" : point.usage === "proposed" ? "（待评估）" : ""
  return `${point.room || "房间待定"} ${point.code || point.name}${state}`
}

function date(value: string) {
  const parsed = new Date(value)
  return Number.isNaN(parsed.getTime()) ? value || "日期待补充" : parsed.toLocaleDateString("zh-CN", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit" })
}

export const FIRST_PROPOSAL_MAX_PAGES = 10
export type FirstProposalDensity = "standard" | "compact"

type ProductSelection = { item: ProjectDeliveryQuoteItem; rooms: string[]; quantity: number }
export type FirstProposalLayout = {
  density: FirstProposalDensity
  rooms: Room[][]
  scenes: PointMapScene[][]
  products: ProductSelection[]
  quotes: ProjectDeliveryQuoteItem[][]
  floors: PointMapPrintFloor[][]
  pageCount: number
  overBudget: boolean
}

/** Space estimates never change, merge or drop a saved quotation line. */
function pages<T>(items: T[], capacity: number, weight: (item: T) => number = () => 1, continuationCapacity = capacity): T[][] {
  const result: T[][] = []
  let current: T[] = [], used = 0
  for (const item of items) {
    const size = weight(item)
    if (current.length && used + size > (result.length ? continuationCapacity : capacity)) {
      result.push(current); current = []; used = 0
    }
    current.push(item); used += size
  }
  if (current.length) result.push(current)
  return result
}

// Approximate rendered lines, respecting explicit newlines and wide CJK glyphs.
function textLines(text: string, width: number) {
  return text.split(/\r?\n/).reduce((sum, line) => sum + Math.max(1, Math.ceil(Array.from(line).reduce((n, char) => n + (/[^\x00-\xff]/.test(char) ? 1 : 0.58), 0) / width)), 0)
}

function productSelections(items: ProjectDeliveryQuoteItem[]): ProductSelection[] {
  const unique = new Map<string, ProductSelection>()
  for (const item of items) {
    const key = JSON.stringify([item.id || item.name, item.brand, item.sku, item.spec, item.unit])
    const existing = unique.get(key)
    if (existing) {
      existing.quantity += item.quantity
      if (!existing.rooms.includes(item.room)) existing.rooms.push(item.room)
    } else unique.set(key, { item, rooms: [item.room], quantity: item.quantity })
  }
  // A clearly labelled visual selection; every saved line remains in the quote.
  return [...unique.values()].slice(0, 6)
}

function layoutAtDensity(snapshot: ProjectDeliverySnapshot, floors: PointMapPrintFloor[], density: FirstProposalDensity): FirstProposalLayout {
  const compact = density === "compact"
  const rooms = pages(projectRooms(snapshot), compact ? 12 : 10, (room) => Math.max(1, textLines(room.name, 30)), 26)
  const scenes = pages(snapshot.plan.scenes ?? [], compact ? 8 : 6, (scene) => {
    const linked = scene.pointIds.map((id) => snapshot.plan.points.find((point) => point.id === id))
    const links = linked.map((point) => point ? pointName(point) : "点位待核对").join("、")
    // Two-column cards. Long descriptions use additional card space.
    return Math.max(1, (textLines(scene.name, 21) + textLines(scene.trigger, 28) + textLines(scene.description, 28) + textLines(links, 32) + 4) / (compact ? 12 : 10))
  })
  const quotes = pages(snapshot.quote?.items ?? [], compact ? 193 : 176, (item) => {
    const width = compact ? 37 : 34
    const lineHeight = compact ? 3.45 : 3.9
    const productLines = textLines(item.name, width) + textLines([item.brand, item.sku].filter(Boolean).join(" · "), width - 4) + (item.spec ? textLines(item.spec, width) : 0) + textLines(quoteVerificationLabel(item), width) + (verificationReasons(item) ? textLines(verificationReasons(item), width + 2) : 0)
    return Math.max(productLines * lineHeight, textLines(item.room || "全屋", 7) * lineHeight, textLines(money(deliveryLineTotal(item)), 7) * lineHeight) + (compact ? 3 : 4)
  })
  const floorPages = pages(floors, compact ? 3 : 2)
  const products = productSelections(snapshot.quote?.items ?? [])
  const pageCount = 1 + Math.max(1, rooms.length) + Math.max(1, scenes.length) + (products.length ? 1 : 0) + Math.max(1, quotes.length) + floorPages.length
  return { density, rooms: rooms.length ? rooms : [[]], scenes: scenes.length ? scenes : [[]], products, quotes: quotes.length ? quotes : [[]], floors: floorPages, pageCount, overBudget: pageCount > FIRST_PROPOSAL_MAX_PAGES }
}

/** Try a tighter complete layout before refusing an oversized document at print time. */
export function createFirstProposalLayout(snapshot: ProjectDeliverySnapshot, floors: PointMapPrintFloor[]): FirstProposalLayout {
  const standard = layoutAtDensity(snapshot, floors, "standard")
  return standard.overBudget ? layoutAtDensity(snapshot, floors, "compact") : standard
}

function projectRooms(snapshot: ProjectDeliverySnapshot): Room[] {
  const rooms = new Map<string, Room>()
  const floors = new Map((snapshot.plan.floors ?? []).map((floor) => [floor.id, floor.name]))
  const quotedRoomNames = [...new Set((snapshot.quote?.items ?? []).map((item) => item.room.trim()))]
  const canonical = (value: string) => value.replace(/\s*\/\s*/g, "/").trim()
  const pointRoomFloors = new Map<string, Set<string>>()
  for (const point of snapshot.plan.points) {
    const room = point.room.trim()
    if (!pointRoomFloors.has(room)) pointRoomFloors.set(room, new Set())
    pointRoomFloors.get(room)!.add(point.floorId ?? "")
  }
  const get = (name: string) => {
    const roomName = name.trim() || "全屋 / 未分房间"
    if (!rooms.has(roomName)) rooms.set(roomName, { name: roomName, points: [], items: [], amount: 0 })
    return rooms.get(roomName)!
  }
  for (const point of snapshot.plan.points) {
    const floorName = floors.get(point.floorId ?? "")
    const composite = floorName ? `${floorName} / ${point.room.trim()}` : point.room
    const quotedComposite = quotedRoomNames.find((room) => canonical(room) === canonical(composite))
    const multipleFloors = (pointRoomFloors.get(point.room.trim())?.size ?? 0) > 1
    get(quotedComposite || (multipleFloors && floorName ? composite : point.room)).points.push(point)
  }
  for (const item of snapshot.quote?.items ?? []) {
    const room = get(item.room)
    room.items.push(item)
    room.amount += deliveryLineTotal(item)
  }
  return [...rooms.values()]
}

function verificationReasons(item: ProjectDeliveryQuoteItem) {
  return quoteVerification(item).reasons.join("；")
}

/**
 * Inline brand marks sit inside 9px text runs in the product list and the quote
 * table, so their box is pinned here rather than by the shared `.fp-brand-logo`
 * rule (10mm square, used by the document brand on the cover and the closing).
 * `display: inline-block` also overrides the document-wide `img { display: block }`
 * so the mark stays on the same line as the brand text, and `maxWidth` keeps an
 * unusually wide wordmark from pushing the text onto its own line.
 */
const BRAND_MARK_STYLE: React.CSSProperties = {
  height: 12, width: "auto", maxWidth: "24mm", objectFit: "contain",
  verticalAlign: "middle", marginRight: 5, display: "inline-block",
}

/**
 * Referential brand mark for one saved quote line. Renders only when the saved
 * `brand` field resolves to a real brand with a verified logo file: ecosystems
 * (Apple Home, Xiaomi Home) and protocols (Matter) stay text-only, and so do
 * unknown brands and brands without a cleared logo (e.g. Apple). The brand text
 * is always kept beside the mark, so the document still reads without images.
 */
function BrandMark({ value }: { value?: string | null }) {
  const asset = resolveProposalBrand(value)
  if (!asset || asset.kind !== "brand" || !asset.logoSrc) return null
  return <img src={asset.logoSrc} alt="" className="fp-brand-logo fp-brand-logo-inline" style={BRAND_MARK_STYLE} />
}

function Brand({ brand, closing = false }: { brand: DocumentBrand; closing?: boolean }) {
  return <div className={`fp-brand${closing ? " fp-brand-closing" : ""}`}>
    {brand.logoSrc ? <img src={brand.logoSrc} alt="" className="fp-brand-logo" /> : null}
    <div><strong>{brand.companyName}</strong>{closing && brand.contact ? <p>{brand.contact}</p> : null}{closing && brand.address ? <p>{brand.address}</p> : null}</div>
  </div>
}

function Footer({ snapshot, brand, demo, label }: { snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean; label: string }) {
  return <footer className="fp-footer"><span>{demo ? "示例演示 · 非客户正式报价" : brand.companyName}</span><span>{label} · {snapshot.version > 0 ? `V${snapshot.version}` : "版本待生成"}</span></footer>
}

function Page({ children, snapshot, brand, demo, label, className = "" }: {
  children: React.ReactNode; snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean; label: string; className?: string
}) {
  return <section className={`fp-page ${className}`} aria-label={label}>
    <div className="fp-running"><span>{brand.companyName}</span><span>{snapshot.project.name}</span></div>
    <div className="fp-page-body">{children}</div>
    <Footer snapshot={snapshot} brand={brand} demo={demo} label={label} />
  </section>
}

function Heading({ title, description, aside }: { title: string; description?: string; aside?: string }) {
  return <header className="fp-heading"><div><h2>{title}</h2>{description ? <p>{description}</p> : null}</div>{aside ? <span>{aside}</span> : null}</header>
}

function Cover({ snapshot, brand, theme, demo }: Omit<FirstProposalDocumentProps, "floors" | "documentRef">) {
  const meta = FIRST_PROPOSAL_THEMES[theme]
  const sidebar = theme === "atelier" || theme === "gallery"
  return <section className={`fp-page fp-cover fp-cover-${theme}`} aria-label="提案封面">
    <div className="fp-cover-brand"><Brand brand={brand} /><span>{demo ? "示例演示" : "首次提案"}</span></div>
    <div className="fp-cover-title"><h1>{meta.coverLines[0]}<br />{meta.coverLines[1]}</h1><p>全屋智能 · 生活体验与空间设计</p></div>
    <div className="fp-cover-composition">
      {sidebar ? <div className="fp-cover-sidebar"><span>{theme === "gallery" ? <>材质有序<br />光影从容</> : <>空间有序<br />生活从容</>}</span><p>{theme === "gallery" ? <>让技术退后，<br />让空间先被感受。</> : <>从一次回家，<br />到每个安心的夜晚。</>}</p><div><strong>{snapshot.project.name}</strong><p>{snapshot.project.customer || "客户信息待补充"}</p></div></div> : null}
      <figure className="fp-cover-image"><img src={meta.heroSrc} alt={meta.heroAlt} /><figcaption>AI 意向示意 · 非项目实景</figcaption></figure>
    </div>
    <div className="fp-cover-project"><div><h2>{snapshot.project.name}</h2><p>{snapshot.project.address || "项目地址待补充"}</p></div><div>{snapshot.project.code ? <span>项目编号 {snapshot.project.code}</span> : null}<span>{snapshot.version > 0 ? `固定交付版本 V${snapshot.version}` : "待生成固定交付版本"}</span><span>{date(snapshot.createdAt)}</span></div></div>
    {!sidebar ? <p className="fp-cover-customer">为 {snapshot.project.customer || "您"} 呈上 · 生活提案 / 场景设计 / 配置与预算</p> : null}
    <Footer snapshot={snapshot} brand={brand} demo={Boolean(demo)} label={meta.name} />
  </section>
}

function Overview({ snapshot, chunks, ...common }: { snapshot: ProjectDeliverySnapshot; chunks: Room[][]; brand: DocumentBrand; demo: boolean }) {
  const quote = snapshot.quote
  const rooms = chunks.flat()
  return chunks.map((chunk, index) => <Page key={index} snapshot={snapshot} {...common} label={`概览 · 预算与确认${index ? ` · 续 ${index}` : ""}`} className="fp-overview-page">
    <Heading title={index ? "空间投入，一目了然。" : "把生活与预算，放在一起看。"} description={index ? "延续本版本的空间索引；金额只汇总已保存报价。" : "先看空间与投入，再读场景、选配和完整报价。所有内容来自同一版本。"} aside={versionLabel(snapshot)} />
    {!index ? <>
      <div className="fp-facts"><div><span>为您呈上</span><strong>{snapshot.project.customer || "客户待补充"}</strong></div><div><span>空间范围</span><strong>{rooms.length} 个配置区域</strong></div><div><span>设计点位</span><strong>{snapshot.plan.points.length} 处</strong></div><div><span>生活场景</span><strong>{snapshot.plan.scenes?.length ?? 0} 项</strong></div></div>
      {quote ? <><div className="fp-budget-total"><div><span>本版应收总额</span><strong>{money(quote.total)}</strong><p>{quote.quoteNo} · {quote.title}</p></div><p>{quote.items.length} 行真实报价<br />{quote.items.filter((item) => quoteVerification(item).status === "unverified").length} 行未核验 · 详见完整报价</p></div><div className="fp-fees"><div><span>产品原价合计</span><strong>{money(quote.subtotal)}</strong></div><div><span>已保存优惠金额</span><strong>{money(quote.discount)}</strong></div><div><span>安装调试费用</span><strong>{money(quote.installationFee)}</strong></div><div><span>方案依据</span><strong>{snapshot.version > 0 ? `固定交付 V${snapshot.version}` : "已保存资料预览"}</strong></div></div></> : <p className="fp-empty">本版尚未保存报价，暂不展示金额。选配与价格明确后，再形成可确认的预算。</p>}
    </> : null}
    <div className="fp-room-index"><h3>空间索引{quote ? " · 产品折后预算" : ""}</h3><table className="fp-budget-table"><thead><tr><th>空间</th><th>设计点位</th><th>报价行数</th>{quote ? <th>折后小计</th> : null}</tr></thead><tbody>{chunk.map((room) => <tr key={room.name}><td><strong>{room.name}</strong>{room.points.some((point) => point.usage === "reserve" || point.usage === "proposed") ? <span>（含预留 / 待评估点位）</span> : null}</td><td>{room.points.length} 处</td><td>{room.items.length} 行</td>{quote ? <td>{money(room.amount)}</td> : null}</tr>)}</tbody></table>{!chunk.length ? <p className="fp-empty">本版尚未保存房间配置，范围需沟通后补充。</p> : null}</div>
    {!index ? <><p className="fp-scope-note">分空间小计仅含对应产品折后金额，安装调试单列；应收以本版已保存总额为准。{QUOTE_SCOPE_NOTE}</p><Confirmation snapshot={snapshot} {...common} /></> : null}
  </Page>)
}

function SceneStory({ scene, snapshot, index }: { scene: PointMapScene; snapshot: ProjectDeliverySnapshot; index: number }) {
  const related = scene.pointIds.map((id) => snapshot.plan.points.find((point) => point.id === id))
  const rooms = [...new Set(related.filter((point): point is PointMapNode => Boolean(point)).map((point) => point.room || "房间待定"))]
  return <article className="fp-scene">
    <div className="fp-scene-title"><span className="fp-scene-index">{String(index + 1).padStart(2, "0")}</span><h3>{scene.name || "未命名场景"}</h3><span className={`fp-status ${scene.status === "confirmed" ? "fp-status-confirmed" : ""}`}>{scene.status === "confirmed" ? "设计已确认" : "待确认"}</span></div>
    <div className="fp-scene-story"><div><span>当您这样做</span><p>{scene.trigger || "触发方式待沟通"}</p></div><div><span>家会这样回应</span><p>{scene.description || "具体动作待沟通"}</p></div></div>
    <p className="fp-scene-links">{rooms.length ? `涉及空间：${rooms.join("、")}。` : "涉及空间待核对。"}{scene.pointIds.length ? `关联 ${scene.pointIds.length} 处点位：${related.map((point) => point ? pointName(point) : "点位待核对").join("、")}` : "本场景尚未关联设备点位。"}</p>
  </article>
}

function Scenes({ snapshot, theme, chunks, ...common }: { snapshot: ProjectDeliverySnapshot; theme: FirstProposalTheme; chunks: PointMapScene[][]; brand: DocumentBrand; demo: boolean }) {
  const scenes = snapshot.plan.scenes ?? []
  const meta = FIRST_PROPOSAL_THEMES[theme]
  let sceneIndex = 0
  return chunks.map((chunk, index) => <Page key={index} snapshot={snapshot} {...common} label={`生活场景${index ? ` · 续 ${index}` : ""}`} className="fp-scenes-page">
    <Heading title={meta.sceneTitle} description="已保存的触发与动作，逐项保留；设计确认与安装验收是不同阶段。" aside={`${scenes.length} 项已保存场景 · ${index + 1}/${chunks.length}`} />
    {!index ? <div className="fp-scene-mood"><figure><img src={meta.sceneSrc} alt={`${meta.name}场景氛围意向`} /><figcaption>AI 意向示意 · 非项目实景</figcaption></figure><p>{meta.sceneQuote.join("")}</p></div> : null}
    <div className="fp-scene-list">{chunk.length ? chunk.map((scene) => <SceneStory key={scene.id} scene={scene} snapshot={snapshot} index={sceneIndex++} />) : <div className="fp-empty"><h3>先聊习惯，再定义场景。</h3><p>本版本尚未保存场景，暂不将生活设想写成已包含功能。确认触发方式、动作与关联设备后，再补入下一版提案。</p></div>}</div>
    <p className="fp-scope-note">“待确认”表示仍需沟通；“设计已确认”不代表设备已经安装或功能已经验收。</p>
  </Page>)
}

function Products({ snapshot, theme, selections, ...common }: { snapshot: ProjectDeliverySnapshot; theme: FirstProposalTheme; selections: ProductSelection[]; brand: DocumentBrand; demo: boolean }) {
  if (!selections.length) return null
  const title = theme === "nature" ? "触手可及的自然舒适。" : theme === "gallery" ? "以器物，勾勒空间秩序。" : theme === "atelier" ? "配置有序，细节有据。" : "看得见的质感，用得上的配置。"
  return <Page snapshot={snapshot} {...common} label="选配精要" className="fp-products-page">
    <Heading title={title} description="本页精选最多六种已报价产品，同型号跨空间合并展示数量。全部产品、规格与未核验原因请见完整报价。" aside={`${snapshot.quote?.items.length ?? 0} 行完整报价 · 精选 ${selections.length} 种`} />
    <div className="fp-product-list">{selections.map(({ item, rooms, quantity }) => {
      const product = snapshot.products.find((product) => product.id === item.id)
      const src = product?.image || item.image
      return <article className="fp-product" key={item.lineId}>
        <div className="fp-product-photo">{src ? <img src={src} alt={item.name} /> : <span>产品图片待补充</span>}</div>
        <div className="fp-product-copy"><span className="fp-product-room">{rooms.join("、") || "全屋 / 未分房间"}</span><h3>{item.name}</h3><p className="fp-product-brand"><BrandMark value={item.brand} />{[item.brand, item.sku].filter(Boolean).join(" · ") || "品牌 / 型号待补充"}</p><div className="fp-product-bottom"><strong>{quantity} {item.unit || "个"}</strong><span>{quoteVerificationLabel(item)}</span></div><p className="fp-product-reason">完整规格、核验原因及未报配套见逐行报价</p></div>
      </article>
    })}</div>
    <p className="fp-scope-note">本页为选配识别摘要，并非完整采购清单。未展示图片的报价行仍完整列于后页。产品图不代替准确规格与现场适配确认。</p>
  </Page>
}

function QuoteDetails({ snapshot, chunks, ...common }: { snapshot: ProjectDeliverySnapshot; chunks: ProjectDeliveryQuoteItem[][]; brand: DocumentBrand; demo: boolean }) {
  const quote = snapshot.quote
  return chunks.map((chunk, index) => <Page key={index} snapshot={snapshot} {...common} label={`完整报价${index ? ` · 续 ${index}` : ""}`} className="fp-quote-page">
    <Heading title="每一项选择，都清楚列明。" description="产品、规格、范围与金额共同构成本次报价。未核验原因与配套遗漏不因排版而省略。" aside={quote?.quoteNo} />
    {quote ? <>
      <div className="fp-quote-context"><span>{quote.title || "项目方案报价"}</span><span>{versionLabel(snapshot)} · {quote.items.length} 行报价</span></div>
      <table className="fp-quote-table"><colgroup><col className="fp-col-product" /><col className="fp-col-room" /><col className="fp-col-quantity" /><col className="fp-col-money" /><col className="fp-col-money" /><col className="fp-col-money" /></colgroup><thead><tr><th>产品 / 规格与说明</th><th>房间</th><th>数量</th><th>原单价</th><th>折后单价</th><th>折后小计</th></tr></thead><tbody>{chunk.map((item) => <tr key={item.lineId} data-quote-line-id={item.lineId}><td><strong>{item.name}</strong><span><BrandMark value={item.brand} />{[item.brand, item.sku].filter(Boolean).join(" · ")}</span>{item.spec ? <span>{item.spec}</span> : null}<span className="fp-verification">{quoteVerificationLabel(item)}</span>{verificationReasons(item) ? <span className="fp-verification-reason">{verificationReasons(item)}</span> : null}</td><td>{item.room || "全屋"}</td><td>{item.quantity}<br />{item.unit || "个"}</td><td>{money(item.price)}</td><td>{money(deliveryLineUnitPrice(item))}</td><td><strong>{money(deliveryLineTotal(item))}</strong></td></tr>)}</tbody></table>
      {index === chunks.length - 1 || !chunks.length ? <div className="fp-quote-summary"><div><span>产品原价</span><strong>{money(quote.subtotal)}</strong></div><div><span>优惠金额</span><strong>{money(quote.discount)}</strong></div><div><span>安装调试</span><strong>{money(quote.installationFee)}</strong></div><div><span>本版应收总额</span><strong>{money(quote.total)}</strong></div></div> : <p className="fp-quote-continued">报价明细续下页；完整合计见本组末页。</p>}
      <p className="fp-scope-note">{QUOTE_SCOPE_NOTE}</p><p className="fp-scope-note">未核验报价用于方案沟通，不等同于正式采购确认。型号、配套用料、实测数量与安装条件应在后续逐项核对。</p>
    </> : <p className="fp-empty">本版尚未保存报价，暂无可列示的产品金额。</p>}
  </Page>)
}

function FloorPlans({ snapshot, chunks, ...common }: { snapshot: ProjectDeliverySnapshot; chunks: PointMapPrintFloor[][]; brand: DocumentBrand; demo: boolean }) {
  return chunks.map((chunk, index) => <Page key={index} snapshot={snapshot} {...common} label={`点位设计图${index ? ` · 续 ${index}` : ""}`} className="fp-floor-page">
    <Heading title="让每一处回应，都有位置。" description="本版本楼层图完整呈现，不裁切原图；安装位置、回路与现场条件需另行核对。" aside={`${versionLabel(snapshot)} · 图组 ${index + 1}/${chunks.length}`} />
    <div className="fp-floor-grid" data-floor-count={chunk.length}>{chunk.map((floor) => <figure className="fp-floor-figure" key={floor.id} data-floor-id={floor.id}><figcaption><strong>{floor.name}</strong><span>完整点位设计图</span></figcaption><div className="fp-floor-image"><img src={floor.src} alt={`${floor.name}完整点位设计图`} /></div></figure>)}</div>
    <p className="fp-scope-note">{snapshot.version > 0 ? "本图复用同一固定版本的楼层图。" : "本图为已保存资料预览，尚未形成固定交付版本。"}预留、待评估与未定位设备不等同于已报价范围。</p>
  </Page>)
}

function Confirmation({ snapshot, brand }: { snapshot: ProjectDeliverySnapshot; brand: DocumentBrand; demo: boolean }) {
  const unplaced = snapshot.plan.points.filter((point) => !point.placed)
  const unverified = snapshot.quote?.items.filter((item) => quoteVerification(item).status === "unverified") ?? []
  const proposed = snapshot.plan.scenes?.filter((scene) => scene.status !== "confirmed") ?? []
  const quotedPointIds = new Set((snapshot.quote?.items ?? []).flatMap((item) => item.pointIds ?? []))
  const pointsToCheck = snapshot.plan.points.filter((point) => !quotedPointIds.has(point.id) && point.usage !== "reserve" && point.usage !== "proposed")
  return <div className="fp-confirmation">
    <div className="fp-confirm-grid"><div><h3>本版待沟通事项</h3><ul><li>{proposed.length} 项场景待确认 · {unplaced.length} 处设备待定位 · {unverified.length} 行产品未核验。</li><li>设计点位不等于已报价范围，预留 / 待评估点位不直接形成采购数量。{pointsToCheck.length ? `另有 ${pointsToCheck.length} 处点位尚未与报价行明确关联，需核对是否由手动报价覆盖。` : ""}</li><li>型号、配套用料、现场条件需复核；工期、付款、质保及售后范围待双方另行约定。</li></ul></div><div><h3>您的想法</h3><p>想保留的体验 / 需要调整的地方</p><div className="fp-note-lines" aria-hidden="true"><span /><span /></div><div className="fp-confirmation-sign"><span>沟通确认</span><i /><span>日期</span><i /></div></div></div>
    <div className="fp-closing"><div><Brand brand={brand} closing /><p className="fp-confirmation-note">记录本次沟通意见；范围、价格及双方权利义务以另行确认的文件为准。</p></div>{brand.qrSrc ? <figure><img src={brand.qrSrc} alt="联系二维码" /><figcaption>扫码联系</figcaption></figure> : null}</div>
  </div>
}

/** All content comes from one immutable delivery; the component never fetches or reprices products. */
export function FirstProposalDocument({ snapshot, floors, brand, theme, documentRef, demo = false }: FirstProposalDocumentProps) {
  const layout = createFirstProposalLayout(snapshot, floors)
  const common = { snapshot, brand, demo }
  return <article ref={documentRef} className={`first-proposal-document fp-theme-${theme}`} data-proposal-theme={theme} data-proposal-density={layout.density} data-proposal-page-count={layout.pageCount} data-proposal-over-budget={layout.overBudget}>
    <Cover {...common} theme={theme} />
    <Overview {...common} chunks={layout.rooms} />
    <Scenes {...common} theme={theme} chunks={layout.scenes} />
    <Products {...common} theme={theme} selections={layout.products} />
    <QuoteDetails {...common} chunks={layout.quotes} />
    <FloorPlans {...common} chunks={layout.floors} />
  </article>
}
