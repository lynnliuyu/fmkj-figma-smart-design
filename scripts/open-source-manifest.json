{
  "note": "自部署版（公开）发行策略。fmkj-v3 是唯一开发主干；本清单由 scripts/open-source-export.mjs 读取，用来把主干的『可公开子集』导出到 fmkj-smart-design。默认只演练，加 --apply 才写入，推送是另一步。",
  "targetRepo": "lynnliuyu/fmkj-smart-design",
  "sourceRepo": "lynnliuyu/fmkj-v3",
  "exclude": [
    ".git/**",
    ".next/**",
    "node_modules/**",
    ".local/**",
    ".workbuddy/**",
    ".impeccable/**",
    ".vscode/**",
    "backups/**",
    "output/**",
    "tmp/**",
    ".env",
    ".env.local",
    ".env.production",
    "docker/cad-export/.env",
    "docker-compose.appliance-external-db.yml",
    "docker-compose.appliance.yml",
    ".env.appliance.example",
    "/*.xlsx",
    "/*.jpg",
    "/*.jpeg",
    "/*.png",
    "/*.drawio",
    "public/assets/products/**",
    "public/assets/reference-drawings/**",
    "public/uploads/**",
    "config/**",
    "public/assets/project-presentations/**",
    "docs/reports/**",
    "docs/architecture/**",
    "docs/architecture-editor-docker.md",
    "docs/architecture-agent-collaboration.md",
    "docs/upload-floorplan-and-marker-outputs.md",
    "docs/deployment-and-catalog-architecture.md",
    "docs/cad-export-api.md",
    "docs/cad-export-docker.md",
    "docs/local-appliance-deployment.md",
    "AI_RUNBOOK.md",
    "docker/architecture-editor/**",
    "docker/cad-export/**",
    "scripts/architecture-editor.py",
    "scripts/architecture-editor-server.py",
    "scripts/architecture-graph.mjs",
    "scripts/build-architecture-overview.py",
    "scripts/open-source-export.mjs",
    "scripts/open-source-manifest.json",
    "scripts/start-cad-export-web.mjs",
    "scripts/cad-export-api.mjs",
    "scripts/cad-export-server.mjs",
    "scripts/cad-export-package.mjs",
    "scripts/cad-import-api.mjs",
    "scripts/prepare-cad-*.mjs",
    "scripts/export-cad-review.mjs",
    "scripts/export-cad-review.command",
    "scripts/cutout/**",
    "scripts/images/**",
    "scripts/review/**",
    "scripts/deploy/**",
    "scripts/archive/**",
    "scripts/mint-session.mjs",
    "scripts/pdf-templates/**",
    "scripts/audit-product-images.mjs",
    "scripts/optimize-product-images.mjs",
    "scripts/prune-unused-product-images.mjs",
    "scripts/generate-point-icons.mjs",
    "tests/cad-export-api.test.ts",
    "tests/cad-export-package.test.ts",
    "tests/cad-review.test.ts",
    "tests/cad-viewport-source.test.ts",
    "tests/prepare-cad-floorplan.test.ts",
    "tests/prepare-cad-reference-drawings.test.ts",
    "tests/export-project-slice.test.ts",
    "tests/cad-import-route.test.ts",
    "tests/cad-import-api.test.ts",
    "tests/deploy-*.test.ts",
    "tests/appliance-handbook.test.ts",
    "tests/open-source-export-policy.test.ts",
    "tests/platform-health.test.ts",
    "plans/028-hosted-local-and-catalog-foundation.md",
    "plans/033-local-appliance-update-and-upstream-service.md",
    "docs/adr/0010-hosted-local-deployment-and-optional-catalog.md",
    "docs/agents/**",
    "docs/open-source-release-process.md",
    "deploy/public-access/**",
    "docs/官方主站-*.md"
  ],
  "preserve": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "FORK_REPORT.md",
    "PACKAGING_REPORT.md",
    "SANITIZATION_REPORT.md",
    "VALIDATION_REPORT.md",
    "CLAUDE.md",
    ".env.example",
    "docs/getting-started.md",
    ".github/**",
    "AGENTS.md",
    ".env.local.example",
    ".env.production.example",
    ".gitignore",
    ".dockerignore",
    "docker-compose.yml",
    "docker-compose.db.yml",
    "docs/agents/**",
    "docs/assets/readme/**"
  ],
  "replace": [
    {
      "name": "客户项目名",
      "pattern": "邦泰璟和|邦泰",
      "with": "示例项目",
      "note": "真实客户项目（含施工图与验收记录）"
    },
    {
      "name": "客户项目名",
      "pattern": "保利天瑞",
      "with": "示例项目",
      "note": "真实客户项目"
    },
    {
      "name": "客户项目名（含楼栋）",
      "pattern": "保利天瑞2?3栋?103[^\\s，、）)]*",
      "with": "示例项目平面图",
      "note": "真实图纸文件名片段"
    },
    {
      "name": "真实报价号",
      "pattern": "QT-2026\\d{4}-[A-Z]{4}",
      "with": "QT-EXAMPLE-DEMO",
      "note": "真实客户报价单号；测试夹具里的 -DEMO 不受影响"
    },
    {
      "name": "个人绝对路径",
      "pattern": "/Users/noonebook",
      "with": "/Users/you",
      "note": "本机个人目录"
    },
    {
      "name": "私有仓库标识",
      "pattern": "lynnliuyu1995-hub/fmkj_v3",
      "with": "lynnliuyu/fmkj-smart-design",
      "note": "正式版私有仓库"
    },
    {
      "name": "内部邮箱域",
      "pattern": "@fmkj\\.dev",
      "with": "@example.com",
      "note": "开发默认账号域"
    },
    {
      "name": "真实产品图引用",
      "pattern": "/assets/products/[A-Za-z0-9._-]+\\.(?:png|jpg|jpeg|webp|svg)",
      "with": "/placeholder.svg",
      "note": "公开版不附带真实产品图"
    },
    {
      "name": "被排除脚本的引用",
      "pattern": "scripts/(?:cad-export-api|cad-export-server|cad-export-package|cad-import-api|export-cad-review|prepare-cad-floorplan|prepare-cad-reference-drawings|start-cad-export-web|mint-session)\\.mjs",
      "with": "（该脚本不随自部署版发布）",
      "note": "避免公开文档指向不存在的脚本；若出现需人工改写说明"
    }
  ],
  "deny": [
    {
      "pattern": "邦泰",
      "why": "真实客户项目名"
    },
    {
      "pattern": "保利天瑞",
      "why": "真实客户项目名"
    },
    {
      "pattern": "QT-2026\\d{4}-(?!DEMO)[A-Z]{4}",
      "why": "真实报价单号"
    },
    {
      "pattern": "/Users/(?!you\\b)[A-Za-z0-9._-]+",
      "why": "个人绝对路径"
    },
    {
      "pattern": "lynnliuyu1995-hub",
      "why": "私有仓库/账号标识"
    },
    {
      "pattern": "@fmkj\\.dev",
      "why": "内部邮箱域"
    },
    {
      "pattern": "sk-[A-Za-z0-9]{20,}",
      "why": "疑似 API Key"
    },
    {
      "pattern": "postgres(?:ql)?://[^\\s\"'<>]*:[^\\s\"'<>@]+@(?!localhost|127\\.0\\.0\\.1|db:)",
      "why": "带密码的远程数据库串"
    },
    {
      "pattern": "BLOB_READ_WRITE_TOKEN\\s*=\\s*[A-Za-z0-9_]{20,}",
      "why": "对象存储令牌"
    },
    {
      "pattern": "BEGIN [A-Z ]*PRIVATE KEY",
      "why": "私钥"
    },
    {
      "pattern": "gh[pousr]_[A-Za-z0-9]{20,}",
      "why": "GitHub 令牌"
    },
    {
      "pattern": "150\\.158\\.3\\.164",
      "why": "运营方自用服务器地址"
    },
    {
      "pattern": "registry\\.fmkj\\.top",
      "why": "运营方自建镜像仓库地址"
    }
  ],
  "denyAllow": [
    {
      "file": "scripts/open-source-manifest.json",
      "why": "策略文件本身含被禁词，且不导出"
    },
    {
      "file": ".env.local.example",
      "why": "环境变量模板，占位值不是真实凭据"
    },
    {
      "file": ".env.production.example",
      "why": "环境变量模板，占位值不是真实凭据"
    },
    {
      "file": ".env.example",
      "why": "环境变量模板，占位值不是真实凭据"
    },
    {
      "file": "docker-compose.db.yml",
      "why": "本地开发数据库默认口令，非线上凭据"
    }
  ],
  "binaryPolicy": {
    "export": false,
    "note": "公开版不含任何二进制/图片（现状：public 下 0 个非文本文件）。图片与素材默认不导出，只在报告里列出，需要时人工决定并加入 binaryAllow。",
    "binaryAllow": []
  },
  "warn": [
    {
      "pattern": "\\.local/",
      "why": "文档提到本地忽略目录；公开版无此目录，属正常（仅提醒）"
    }
  ]
}
