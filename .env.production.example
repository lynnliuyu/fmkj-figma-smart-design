# Copy this file to .env.production on the server and fill real values.

# PostgreSQL。
# 本地设备版（docker-compose.appliance.yml）：用同编排里的 postgres 服务，
# 主机名就是服务名 postgres；这时还要填下面的 POSTGRES_* 三个变量，且口令必须一致。
DATABASE_URL=postgresql://fmkj:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/fmkj
# 外部/1Panel 上的 PostgreSQL：把 DATABASE_URL 指过去即可（host.docker.internal 让
# Linux 上的业务容器能连到宿主机数据库），不需要下面的 POSTGRES_*。
# DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DATABASE_NAME
DATABASE_SSL=false
PRODUCTS_TABLE=products

# 仅本地设备版需要：postgres 容器用它初始化数据库，必须与 DATABASE_URL 里的
# 用户名/口令/库名一致，否则应用连不上。
POSTGRES_USER=fmkj
POSTGRES_PASSWORD=CHANGE_ME_SAME_AS_DATABASE_URL
POSTGRES_DB=fmkj

# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
AUTH_DEV_MODE=false

# 会话 Cookie 的 Secure 标志：auto（默认，按 x-forwarded-proto 判断）| true | false。
# 本地设备版用 http://<设备IP>:3000 访问时必须是 auto 或 false，否则浏览器不会保存
# 会话 Cookie（表现为「登录提示成功但还是未登录」）。托管版走 HTTPS，保持 auto 即可。
AUTH_COOKIE_SECURE=auto

# 附件存储。本地设备版用 local（写数据卷 fmkj-v3-uploads，经 /api/files 受鉴权读取）；
# 托管版可以设为 blob 并填下面的 token，保持原有公网 URL 行为。
FILE_STORAGE=local
FMKJ_STORAGE_ROOT=/data/uploads

# 仅 FILE_STORAGE=blob 时需要（产品图、报价 PDF、合同、户型图等上传）。
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# 官方产品资料同步（可选；自建模式不用配，留空即关闭）
#
# 托管版（正式版）想让订阅设备拉产品目录时，配一个发布令牌：
#   CATALOG_PUBLISH_TOKEN  设备用它作为 Bearer 调用 GET /api/catalog/snapshot
# 不配该变量时，这个接口按 404 关闭，不会对外给出空目录。
# ---------------------------------------------------------------------------
CATALOG_PUBLISH_TOKEN=
# 想让设备能确认「这份目录是你发的」（而不只是「没被改过」），在发布端配一个 Ed25519 私钥：
#   CATALOG_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 私钥只留在运营方服务器上，公钥给设备。没配私钥时接口照常发布，只是不带签名。

# 设备侧（订阅方）配置：三个都齐了才会去连，少一个都当作「没接官方资料」。
# UPSTREAM_ENABLED=true
# UPSTREAM_BASE_URL=https://your-host.example.com
# LICENSE_KEY=与发布端 CATALOG_PUBLISH_TOKEN 对应的订阅凭据
# INSTANCE_ID=这台设备的标识（不含客户信息）
#
# UPSTREAM_PUBLIC_KEY=运营方公钥（PEM）。配了之后，设备只接受签过名的目录；
# 想临时放宽（例如灰度）可以加 UPSTREAM_ALLOW_UNSIGNED=true，此时状态里会标明「未签名」。
# 同步时会把资料里的产品图一起取回本地（每次最多 200 张，其余下次继续）。
#
# 定时同步：配好上面三项后，应用启动时会排期自动同步，默认每 24 小时一次。
# 只补本地没有的新品，不覆盖本地改过的价格；想关掉定时（只留页面上手动点）就设 false。
# UPSTREAM_SYNC_ENABLED=true
# UPSTREAM_SYNC_INTERVAL_HOURS=24
# UPSTREAM_SYNC_STARTUP_DELAY_MINUTES=5
#
# 版本清单验签（设备侧）：配了公钥就只认签过名的清单，防止有人伪造「有新版本」
# 把设备引到恶意镜像上。清单用 scripts/deploy/sign-version-index.mjs 生成。
# FMKJ_RELEASE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
