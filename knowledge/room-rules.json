{
  "scoringRule": "score = 已满足的(必备 core + 推荐 recommended)项数量 / 总(必备 core + 推荐 recommended)项数量 × 100（四舍五入，可选 optional 不计入分母）",
  "designRules": {
    "summaryText": "开关、插座、灯具只在图纸上已有准确点位符号时照图生成（source 标为 \"drawing\"）；图上没有就不要生成，不得凭经验推测。其余默认设计：全屋 WiFi（ap-node、network-panel）、窗帘电轨 curtain-track、智能网关 gateway、VRF 控制器 vrf-controller、人体传感器 motion-sensor、智能音箱 speaker、摄像头 camera（source 标为 \"design\"）。数量规范：VRF 控制器每层只放 1 个且放在客厅；智能音箱与中控屏每个区域只放其中一种、只放 1 个，不能共存；智能音箱一般只放客厅和书房；中控屏 touch-panel 要对照开关点位布置，图上没有开关点位时不要加入；摄像头一般只放 2 个——客厅 1 个、入户门口 1 个。",
    "drawingOnlyCategories": ["switch", "socket", "lighting"],
    "autoDesignTypes": [
      "ap-node",
      "network-panel",
      "curtain-track",
      "gateway",
      "vrf-controller",
      "motion-sensor",
      "speaker",
      "camera"
    ],
    "needsSwitchTypes": ["touch-panel"],
    "speakerAreaTypes": ["living", "study"],
    "onePerAreaTypes": ["speaker", "touch-panel"],
    "vrfPerFloor": 1,
