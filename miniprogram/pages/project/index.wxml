<view wx:if="{{unassigned}}" class="page page-pad-bottom">
  <view class="card">
    <view class="h2">{{unassigned.community || '业主需求'}}</view>
    <view class="kv mt-16"><text class="muted">面积</text><text>{{unassigned.area ? unassigned.area + '㎡' : '待确认'}}</text></view>
    <view class="kv"><text class="muted">预算</text><text>{{unassigned.budgetText}}</text></view>
    <view class="kv"><text class="muted">提交时间</text><text>{{unassigned.date}}</text></view>
    <view wx:if="{{unassigned.pendingPriceCount > 0}}" class="kv">
      <text class="muted shrink-0">待查价</text>
      <text class="text-right">{{unassigned.pendingPriceNames ? unassigned.pendingPriceNames + '（' + unassigned.pendingPriceCount + ' 项）' : unassigned.pendingPriceCount + ' 项'}}</text>
    </view>
    <view class="notice mt-16"><text>{{unassigned.summary}}</text></view>
    <button class="btn btn-primary btn-block mt-24" loading="{{claiming}}" disabled="{{claiming}}" bindtap="claim">领取</button>
  </view>
</view>
<view wx:elif="{{p}}" class="page page-pad-bottom">
  <view class="card">
    <view class="row between gap-16">
      <view class="row gap-8 grow">
        <view class="h2 truncate">{{p.displayName}}</view>
        <text wx:if="{{p.isDemo}}" class="badge badge-brand shrink-0">示例</text>
      </view>
      <text class="badge {{p.stageBadge}} shrink-0">{{p.stageLabel}}</text>
    </view>
    <view class="progress-wrap mt-24">
      <view class="steps">
        <view wx:for="{{p.steps}}" wx:key="index" class="step {{item ? 'done' : ''}}" />
      </view>
      <view class="step-labels mt-8">
        <text wx:for="{{stepLabels}}" wx:key="*this" class="small {{p.steps[index] ? '' : 'muted'}}">{{item}}</text>
      </view>
    </view>
    <view class="mt-16">
      <view class="kv">
        <text class="muted">客户</text>
        <view class="row gap-16">
          <text>{{p.customerName || '未填写'}}</text>
          <view wx:if="{{p.customerPhone}}" class="row gap-8" hover-class="btn-hover" bindtap="call">
            <image class="icon-sm" src="/assets/icons/phone.svg" />
            <text class="num">{{p.customerPhone}}</text>
          </view>
        </view>
      </view>
      <view class="kv"><text class="muted">地址</text><text class="text-right grow">{{p.place || '—'}}</text></view>
      <view class="kv"><text class="muted">主平台</text><text>{{p.platform || '待定'}}</text></view>
      <view class="kv"><text class="muted">预算</text><text class="num">{{p.budgetText || '—'}}</text></view>
      <view class="kv"><text class="muted">负责人</text><text>{{owner ? owner.name : '—'}}</text></view>
    </view>
    <view wx:if="{{p.notes}}" class="notice mt-16">{{p.notes}}</view>
    <view wx:if="{{!archived}}" class="ai-entry mt-24" hover-class="list-item-hover" bindtap="openAiWithProject">
      <image class="icon-sm" src="/assets/icons/sparkles.svg" />
      <text class="grow small">在 AI 助手中关联此项目（点位审查 / 智能选型 / 改价）</text>
      <image class="icon-sm" src="/assets/icons/chevron-right-muted.svg" />
    </view>
  </view>

  <view class="section-title"><text class="title">点位与预算</text></view>
  <view class="card">
    <view class="mini-stats">
      <view><text class="label">点位</text><text class="num block">{{summary.points}}</text></view>
      <view><text class="label">房间</text><text class="num block">{{summary.rooms}}</text></view>
      <view><text class="label">图纸</text><text class="num block">{{summary.sheets}}</text></view>
      <view><text class="label">设备预算</text><text class="num block">{{summary.totalText}}</text></view>
    </view>
    <view wx:if="{{summary.pending}}" class="notice notice-warning mt-24">
      <image class="icon-sm" src="/assets/icons/alert.svg" />
      <text>{{summary.pending}} 个点位待选型，未计入预算</text>
    </view>
    <view wx:if="{{summary.categories.length}}" class="row wrap gap-12 mt-24">
      <view wx:for="{{summary.categories}}" wx:key="slug" class="chip">
        <view class="dot" style="background: {{item.color}}" />
        <text>{{item.name}}</text>
        <text class="num">{{item.count}}</text>
      </view>
    </view>
    <view class="row gap-16 mt-24">
      <button wx:if="{{!archived}}" class="btn btn-outline grow" hover-class="btn-hover" bindtap="uploadSheet">
        <image class="icon-sm" src="/assets/icons/image-plus.svg" />上传户型图
      </button>
      <button class="btn btn-primary grow" hover-class="btn-hover" bindtap="openPointMap">
        <image class="icon-sm" src="/assets/icons/map-pin-white.svg" />打开点位图
      </button>
    </view>
  </view>

  <view class="section-title">
    <text class="title">报价</text>
    <view wx:if="{{!archived && summary.points}}" class="row gap-8 small" hover-class="btn-hover" bindtap="generateQuote">
      <image class="icon-sm" src="/assets/icons/plus.svg" />从点位图生成
    </view>
  </view>
  <view class="card card-flush">
    <view wx:for="{{quotes}}" wx:key="id" class="list-item" hover-class="list-item-hover" data-id="{{item.id}}" bindtap="openQuote">
      <image class="icon" src="/assets/icons/receipt.svg" />
      <view class="grow truncate">{{item.title}}</view>
      <view class="text-right shrink-0">
        <view class="num">{{item.totalText}}</view>
        <view class="badge {{item.badge}} mt-8">{{item.statusLabel}}</view>
      </view>
    </view>
    <view wx:if="{{!quotes.length}}" class="empty small">{{summary.points ? '还没有报价，点右上角从点位图生成' : '布置点位后可以自动生成报价'}}</view>
  </view>

  <view class="section-title"><text class="title">合同</text></view>
  <view class="card" hover-class="list-item-hover" bindtap="openContract">
    <block wx:if="{{contract}}">
      <view class="row between">
        <text class="num">{{contract.number}}</text>
        <text class="badge {{contract.badge}}">{{contract.statusLabel}}</text>
      </view>
      <view class="row between mt-16">
        <text class="big-num">{{contract.amountText}}</text>
        <text class="small muted">收款 {{contract.received}}/{{contract.payments.length}} 期</text>
      </view>
    </block>
    <view wx:else class="row between">
      <text class="muted">{{quotes.length ? '用一份报价生成合同' : '生成报价后可以生成合同'}}</text>
      <image class="icon-sm" src="/assets/icons/chevron-right-muted.svg" />
    </view>
  </view>

  <view class="section-title"><text class="title">资料导出</text></view>
  <block wx:if="{{proposal}}">
    <view class="card tpl-card" hover-class="list-item-hover" bindtap="openTemplates">
      <image class="tpl-cover" src="{{proposal.thumbUrl}}" mode="aspectFill" />
      <view class="grow tpl-meta">
        <view class="row gap-8">
          <text class="title truncate">{{proposal.label}}</text>
          <text class="badge shrink-0">{{proposal.tierBadge}}</text>
        </view>
        <view class="small muted mt-8 clamp-2">适合：{{proposal.audience}}</view>
        <view class="small muted mt-8">{{proposal.chosen ? '已设为交付方案模板' : '默认模板 · 共 ' + proposal.count + ' 套可选'}}</view>
      </view>
      <image class="icon-sm shrink-0" src="/assets/icons/chevron-right-muted.svg" />
    </view>
    <view class="row gap-16 mt-16 tpl-actions">
      <button class="btn btn-outline grow" hover-class="btn-hover" bindtap="openTemplates">
        <image class="icon-sm" src="/assets/icons/layers.svg" />切换模板
      </button>
      <button class="btn btn-primary grow" hover-class="btn-hover" bindtap="previewProposal">
        <image class="icon-sm" src="/assets/icons/file-white.svg" />预览方案
      </button>
    </view>
  </block>
  <view class="card card-flush">
    <view wx:for="{{documents}}" wx:key="key" class="list-item" hover-class="list-item-hover" data-path="{{item.path}}" data-title="{{item.title}}" bindtap="openDoc">
      <image class="icon" src="/assets/icons/printer.svg" />
      <view class="grow">
        <view>{{item.title}}</view>
        <view class="small muted truncate">{{item.note}}</view>
      </view>
      <image class="icon-sm" src="/assets/icons/chevron-right-muted.svg" />
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-outline" hover-class="btn-hover" bindtap="toggleArchive">
      <image class="icon-sm" src="/assets/icons/archive.svg" />{{archived ? '恢复项目' : '归档'}}
    </button>
    <button class="btn btn-primary" hover-class="btn-hover" disabled="{{archived}}" bindtap="edit">
      <image class="icon-sm" src="/assets/icons/pencil-white.svg" />编辑资料
    </button>
  </view>

  <block wx:if="{{tplSheet}}">
    <view class="mask" bindtap="closeTemplates" />
    <view class="sheet">
      <view class="sheet-head">
        <view>
          <text class="title">选择交付方案模板</text>
          <view class="small muted mt-8">点卡片切换，点「预览」先看套用效果</view>
        </view>
        <image class="icon" src="/assets/icons/x-muted.svg" bindtap="closeTemplates" />
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view wx:if="{{tplLoading}}" class="empty small">加载中…</view>
        <view
          wx:for="{{templates}}"
          wx:key="slug"
          class="tpl-item {{item.slug === tplCurrent ? 'tpl-item-active' : ''}}"
          hover-class="list-item-hover"
          data-slug="{{item.slug}}"
          bindtap="pickTemplate"
        >
          <image class="tpl-thumb" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load />
          <view class="grow tpl-meta">
            <view class="row gap-8 wrap">
              <text class="tpl-name">{{item.label}}</text>
              <text class="badge">{{item.tierBadge}}</text>
              <text wx:if="{{item.slug === tplCurrent}}" class="badge badge-success">当前</text>
              <view wx:if="{{item.locked}}" class="badge badge-warning row gap-8">
                <image class="tpl-lock" src="/assets/icons/lock-muted.svg" />需升级
              </view>
            </view>
            <view class="small muted mt-8 clamp-2">适合：{{item.audience}}</view>
            <view class="small muted mt-8 clamp-2">时机：{{item.occasion}}</view>
            <view wx:if="{{item.highlights.length}}" class="row gap-8 wrap mt-16">
              <text wx:for="{{item.highlights}}" wx:for-item="h" wx:key="*this" class="tpl-tag">{{h}}</text>
            </view>
          </view>
          <view class="tpl-preview" data-slug="{{item.slug}}" catchtap="previewTemplate">预览</view>
        </view>
        <view wx:if="{{!tplLoading && !templates.length}}" class="empty small">暂无可用模板</view>
      </scroll-view>
    </view>
  </block>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>
<view wx:else class="empty">项目暂时不可查看</view>
<privacy-popup id="privacy-popup" />
