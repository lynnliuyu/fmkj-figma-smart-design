<view class="page">
  <view class="card row gap-24">
    <view class="avatar">{{initial}}</view>
    <view class="grow">
      <view class="h2 truncate">{{me.name}}</view>
      <view class="small muted mt-8 truncate">{{me.email}}</view>
      <view class="small muted truncate">{{me.phone || '未填写手机号'}}</view>
    </view>
    <view class="icon-btn" hover-class="btn-hover" bindtap="openEdit"><image class="icon" src="/assets/icons/pencil.svg" /></view>
  </view>

  <view class="stats two mt-24">
    <view class="stat"><text class="label">AI 积分</text><text class="num">{{me.aiCredits || 0}}</text></view>
    <view class="stat" bindtap="openRedeem"><text class="label">会员等级</text><text class="num">{{me.membershipBadge || 'Go'}}</text></view>
  </view>

  <view class="card card-flush mt-24">
    <view class="list-item" hover-class="list-item-hover" bindtap="openNeed">
      <image class="icon" src="/assets/icons/sparkles.svg" />
      <text class="grow">帮我出方案</text>
      <text class="small muted">选几个问题就有清单</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="openRedeem">
      <image class="icon" src="/assets/icons/sparkles.svg" />
      <text class="grow">兑换码激活 / 充积分</text>
      <text class="small muted">{{me.membershipLabel || '输入兑换码'}}</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="scanWebLogin">
      <image class="icon" src="/assets/icons/maximize.svg" />
      <text class="grow">扫码登录电脑端</text>
      <text class="small muted">扫一扫电脑二维码</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="wechat">
      <image class="icon" src="/assets/icons/link.svg" />
      <text class="grow">微信绑定</text>
      <text class="small muted">{{me.wechatBound ? '解除绑定' : '用微信登录时绑定'}}</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="company">
      <image class="icon" src="/assets/icons/building.svg" />
      <text class="grow">公司信息</text>
      <text class="small muted truncate">{{companyName}}</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="plugins">
      <image class="icon" src="/assets/icons/layers.svg" />
      <text class="grow">已启用插件</text>
      <text class="small muted">{{pluginCount}} 个</text>
    </view>
    <view class="list-item">
      <image class="icon" src="/assets/icons/file.svg" />
      <text class="grow">服务器</text>
      <text class="small muted truncate">{{host}}</text>
    </view>
    <view class="list-item">
      <image class="icon" src="/assets/icons/check.svg" />
      <text class="grow">版本</text>
      <text class="small muted">v{{version}}</text>
    </view>
    <view class="list-item" hover-class="list-item-hover" bindtap="privacy">
      <image class="icon" src="/assets/icons/lock.svg" />
      <text class="grow">隐私保护指引</text>
      <text class="small muted">查看</text>
    </view>
  </view>
  <view class="small muted mt-24">账号、产品库和插件由管理员在网页版后台维护；小程序与网页版使用同一份数据。</view>

  <button class="btn btn-danger btn-block mt-32" hover-class="btn-hover" bindtap="logout"><image class="icon-sm" src="/assets/icons/logout.svg" />退出登录</button>

  <block wx:if="{{editing}}">
    <view class="mask" bindtap="closeEdit" />
    <view class="sheet">
      <view class="sheet-head"><text class="title">修改资料</text><image class="icon" src="/assets/icons/x-muted.svg" bindtap="closeEdit" /></view>
      <view class="sheet-body">
        <view class="field"><view class="field-label">姓名</view><input class="input" value="{{form.name}}" data-key="name" bindinput="onInput" /></view>
        <view class="field"><view class="field-label">手机号（作为联系人显示在报价单上）</view><input class="input" type="number" value="{{form.phone}}" data-key="phone" bindinput="onInput" /></view>
        <button class="btn btn-primary btn-block mt-24" hover-class="btn-hover" loading="{{saving}}" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </block>

  <block wx:if="{{redeeming}}">
    <view class="mask" bindtap="closeRedeem" />
    <view class="sheet">
      <view class="sheet-head"><text class="title">Go / Plus / Pro 会员权益与兑换</text><image class="icon" src="/assets/icons/x-muted.svg" bindtap="closeRedeem" /></view>
      <scroll-view scroll-y class="sheet-body tier-sheet-body">
        <view class="tier-list">
          <view class="tier-card tier-pro">
            <view class="row between">
              <text class="tier-title">Plus 专业版</text>
              <text class="badge badge-ink">推荐订阅</text>
            </view>
            <view class="small muted mt-8">独立设计师与工作室高定交付首选</view>
            <view class="tier-perks mt-16">
              <view class="tier-perk">✓ 每月赠 300 AI 积分 · 50 个项目 · 5 人协同</view>
              <view class="tier-perk">✓ 解锁 Plus 高阶视觉多模态模型（Qwen-VL-Max / 豆包 Vision / GLM-4V-Plus）</view>
              <view class="tier-perk">✓ 解锁墨金臻选、智域科技、晨曦暖调、素白极简模板 + 6 套报价风格</view>
              <view class="tier-perk">✓ 解锁 DWG 导入、强弱电布线表、场景移交单与一键交付资料包</view>
            </view>
          </view>

          <view class="tier-card">
            <view class="row between">
              <text class="tier-title">Pro 旗舰版</text>
              <text class="badge">旗舰尊享</text>
            </view>
            <view class="small muted mt-8">适合全屋智能集成商与工程交付团队</view>
            <view class="tier-perks mt-16">
              <view class="tier-perk">✓ 每月赠 1,000 AI 积分 · 不限项目数 · 不限协作成员</view>
              <view class="tier-perk">✓ 独占 Pro 满血深度推理模型（DeepSeek-R1 / 通义 QwQ-Plus / QVQ-Max）</view>
              <view class="tier-perk">✓ 包含 Plus 全部特权 + 独占「东方雅韵」顶奢别墅模板与采购备货核验单</view>
            </view>
          </view>
        </view>

        <view class="field">
          <view class="field-label">兑换码（激活会员时长或充值 AI 积分）</view>
          <input class="input" placeholder="如 FMKJ-XXXX-XXXX-XXXX" value="{{redeemCode}}" bindinput="onRedeemInput" />
        </view>
        <button class="btn btn-primary btn-block mt-24" hover-class="btn-hover" loading="{{saving}}" bindtap="submitRedeem">立即兑换</button>

        <view wx:if="{{me.creditTasks && me.creditTasks.length}}" class="mt-32">
          <view class="field-label">免费领积分 · 绑定与福利任务</view>
          <view class="card card-flush mt-8">
            <view wx:for="{{me.creditTasks}}" wx:key="id" class="list-item">
              <view class="grow">
                <view class="row gap-12">
                  <text>{{item.title}}</text>
                  <text class="badge">+{{item.credits}}分</text>
                </view>
                <view class="small muted mt-4">{{item.description}}</view>
              </view>
              <text wx:if="{{item.claimed}}" class="small muted">已领取</text>
              <button wx:elif="{{item.eligible}}" class="btn btn-primary btn-sm" data-id="{{item.id}}" bindtap="claimTask">领取</button>
              <text wx:else class="small muted">待完成</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
<privacy-popup id="privacy-popup" />
