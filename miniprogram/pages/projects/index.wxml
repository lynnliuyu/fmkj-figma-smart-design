<view class="page page-pad-bottom">
  <view class="search">
    <image class="icon-sm" src="/assets/icons/search-muted.svg" />
    <input placeholder="{{status === 'unassigned' ? '搜索小区' : '搜索项目、客户、小区'}}" placeholder-class="placeholder" value="{{q}}" confirm-type="search" bindinput="onQuery" bindconfirm="reload" />
    <image wx:if="{{q}}" class="icon-sm" src="/assets/icons/x-muted.svg" bindtap="clearQuery" />
  </view>
  <view class="seg mt-24">
    <view wx:for="{{filters}}" wx:key="value" class="seg-item {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</view>
  </view>

  <view class="card card-flush mt-24">
    <block wx:if="{{status === 'unassigned'}}">
      <view wx:for="{{items}}" wx:key="id" class="list-item" hover-class="list-item-hover" data-id="{{item.id}}" bindtap="open">
        <view class="grow">
          <view class="title truncate">{{item.community || '业主需求'}}</view>
          <view class="small muted mt-8">{{item.area ? item.area + '㎡ · ' : ''}}{{item.budgetText}} · {{item.pendingPriceCount}} 项待查价</view>
        </view>
        <text class="small muted shrink-0">{{item.date}}</text>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{items}}" wx:key="id" class="list-item" hover-class="list-item-hover" data-id="{{item.id}}" bindtap="open">
        <view class="grow">
          <view class="row gap-8">
            <text class="title truncate">{{item.displayName}}</text>
            <text wx:if="{{item.isDemo}}" class="badge badge-brand shrink-0">示例</text>
            <text class="badge {{item.stageBadge}} shrink-0">{{item.stageLabel}}</text>
          </view>
          <view class="small muted mt-8 truncate">{{item.metaLine}}</view>
        </view>
        <text class="small muted shrink-0">{{item.time}}</text>
      </view>
    </block>
    <view wx:if="{{!loading && !items.length}}" class="empty">
      <image class="icon-lg" src="/assets/icons/folder-muted.svg" />
      <text>{{q ? '没有找到匹配的项目' : status === 'unassigned' ? '暂无待领取的项目' : status === 'archived' ? '还没有归档的项目' : '还没有项目'}}</text>
    </view>
    <view wx:if="{{loading}}" class="empty small">加载中…</view>
  </view>
  <view wx:if="{{items.length && !hasMore}}" class="small muted text-center mt-24">共 {{total}} 个项目</view>

  <view class="fab" hover-class="btn-hover" bindtap="create">
    <image class="icon" src="/assets/icons/plus-white.svg" />
    <text>新建项目</text>
  </view>
</view>
<privacy-popup id="privacy-popup" />
