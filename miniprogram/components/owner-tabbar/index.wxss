.owner-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--paper, #fff);
  border-top: 1rpx solid var(--rule, #e5e5e5);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #8a8a8a;
}
.tab.active { color: #171717; }
.tab-icon { width: 40rpx; height: 40rpx; }
.tab-text { font-size: 20rpx; line-height: 1.2; }
