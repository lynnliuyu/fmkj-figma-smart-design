<view class="owner-tabbar">
  <view wx:for="{{list}}" wx:key="pagePath" class="tab {{selected === index ? 'active' : ''}}"
        data-path="{{item.pagePath}}" bindtap="switchTo">
    <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
