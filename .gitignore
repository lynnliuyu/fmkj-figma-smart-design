# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# 自托管迁移数据（含客户信息，不提交）
/import/
/media/

# 桌面客户端安装包（上传到服务器的 desktop-releases 目录，不提交）
/desktop-releases/

# Figma Make 调试 / 评审临时文件
/.tmp/
/.figaro/
/.impeccable/
/.export-artifacts/

# LoopForge Local / DevFlow 运行产物与本地观测日志（不入库）
/artifacts/
/.superpowers/
.cursor/skills/agent-observability/logs/*
!.cursor/skills/agent-observability/logs/.gitkeep

# 运营物料（约 96MB 二进制：方案样张、报价单版式、点位图、推广文案）
# 不随代码分发：里面有已作废的兑换码，且二进制不该混进源码仓库。
# 备份在 ~/Backups/promotion-kit-*.tar.gz
/promotion-kit/

# PLAN-MAP.md 的渲染产物（本地查看用，不入库）
/plan-map.html
