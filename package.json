{
  "name": "next-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000} --hostname 0.0.0.0",
    "build": "NODE_OPTIONS=--no-deprecation payload build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "format": "oxfmt",
    "test": "vitest run",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "knowledge:export": "NODE_OPTIONS=--no-deprecation payload run --input '{\"scriptPath\":\"scripts/export-domain-knowledge.ts\"}'",
    "knowledge:check": "NODE_OPTIONS=--no-deprecation payload run --input '{\"scriptPath\":\"scripts/export-domain-knowledge.ts\",\"scriptArgs\":[\"--check\"]}'",
    "templates:seed": "NODE_OPTIONS=--no-deprecation payload run --input '{\"scriptPath\":\"scripts/seed-proposal-library.ts\"}'",
    "templates:thumbs": "node scripts/generate-template-thumbnails.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-butter": "0.7.11",
    "@astryxdesign/theme-chocolate": "0.7.11",
    "@astryxdesign/theme-matcha": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@astryxdesign/theme-stone": "0.7.11",
    "@heroicons/react": "2.2.0",
    "@payloadcms/db-postgres": "4.0.0-beta.4",
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.4",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.4",
    "@payloadcms/plugin-mcp": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/storage-s3": "4.0.0-beta.4",
    "@payloadcms/translations": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "@stylexjs/stylex": "0.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "html-to-image": "1.11.13",
    "input-otp": "1.4.1",
    "lucide-react": "^1.63.0",
    "monaco-editor": "0.55.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-beta.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "potrace": "2.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@astryxdesign/core",
      "@astryxdesign/theme-neutral",
      "@astryxdesign/cli"
    ]
  }
}
