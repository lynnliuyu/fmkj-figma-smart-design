# 本地设备版：compose 插值文件（设备上复制成 `.env`，与 docker-compose.appliance.yml 同目录）。
# 这里只放「跑哪一版镜像」这类编排级变量；业务配置（数据库口令、AUTH_SECRET）在 .env.production。
#
# 设备拉不通 Docker Hub 时，POSTGRES_IMAGE 指向自建仓库里的 postgres 副本。
FMKJ_IMAGE=fmkj-v3:v0.1.0
FMKJ_VERSION=v0.1.0
POSTGRES_IMAGE=postgres:17-alpine

# 默认监听所有网卡，局域网访问 http://<设备IP>:8890；只想本机访问就改成 127.0.0.1。
# 端口也可用 FMKJ_PORT 改（默认 8890，避开开发机常用的 3000）。
FMKJ_BIND=0.0.0.0

# 更新提醒（只检查、不安装）。设备上跑 scripts/deploy/check-update.mjs 时读这几个值：
#   FMKJ_UPDATE_INDEX_URL                一个 JSON 版本清单，例如 {"versions":["v0.1.0","v0.1.1"]}
#   FMKJ_REGISTRY / FMKJ_REGISTRY_REPOSITORY  不填清单地址时改问镜像仓库的 tag 列表
#   FMKJ_REGISTRY_USER / FMKJ_REGISTRY_PASSWORD  仓库需要登录时填
# 结果写进 deploy-state/update-check.json，管理员页面「系统健康」里能看到。
# FMKJ_UPDATE_INDEX_URL=https://example.com/fmkj-versions.json
